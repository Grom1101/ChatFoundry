{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=client_db;Port=5432;Database=foundry_db;Username=foundry;Password=foundry",
    "Kafka": "kafka:9092"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "GraphQlCache": {
    "CacheableQueries": [
      "GetClients",
      "GetClientChannels",
      "GetMessages",
      "GetAttributes",
      "GetCompanyAttributeDefinitions"
    ],
    "QueryTags": {
      "GetClients": [ "company:{companyId}:clients" ],
      "GetClientChannels": [ "company:{companyId}:channels" ],
      "GetMessages": [ "company:{companyId}:messages" ],
      "GetAttributes": [ "company:{companyId}:attributes" ],
      "GetCompanyAttributeDefinitions": [ "company:{companyId}:attributes" ]
    },
    "QueryTtls": {
      "GetClients": 120,
      "GetClientChannels": 120,
      "GetMessages": 60,
      "GetAttributes": 300,
      "GetCompanyAttributeDefinitions": 300
    },
    "DefaultTtlSeconds": 60
  },
  "Observability": {
    "ServiceName": "client-service",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  }
}
