{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kafka": "kafka:9092"
  },
  "Services": {
    "WorkflowServiceUrl": "http://workflow-service:8081"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "Sms": {
    "ApiUrl": "https://api.infinireach.io/api/v1/messages"
  },
  "Observability": {
    "ServiceName": "sms-service",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  }
}
