{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=company_db;Port=5432;Database=foundry_db;Username=foundry;Password=foundry"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "GraphQlCache": {
    "CacheableQueries": [
      "GetCompanies",
      "GetCompanyMembers",
      "GetInvitations"
    ],
    "QueryTags": {
      "GetCompanies": [ "company:{companyId}" ],
      "GetCompanyMembers": [ "company:{companyId}:members" ],
      "GetInvitations": [ "company:{companyId}:invitations" ]
    },
    "QueryTtls": {
      "GetCompanies": 300,
      "GetCompanyMembers": 120,
      "GetInvitations": 60
    },
    "DefaultTtlSeconds": 60
  },
  "IdentityService": {
    "GrpcAddress": "http://identity-service:8081"
  },
  "Observability": {
    "ServiceName": "company-service",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  }
}
