{
  "ConnectionStrings": {
    "DefaultConnection": "Host=workflow_db;Port=5432;Database=foundry_db;Username=foundry;Password=foundry",
    "Kafka": "kafka:9092"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "GraphQlCache": {
    "CacheableQueries": [
      "GetBots",
      "GetChannels",
      "GetSessions",
      "GetWorkflows",
      "GetActionEntities"
    ],
    "QueryTags": {
      "GetBots": [ "company:{companyId}:bots" ],
      "GetChannels": [ "company:{companyId}:channels" ],
      "GetSessions": [ "company:{companyId}:sessions" ],
      "GetWorkflows": [ "company:{companyId}:workflows" ],
      "GetActionEntities": [ "company:{companyId}:actions" ]
    },
    "QueryTtls": {
      "GetBots": 120,
      "GetChannels": 120,
      "GetSessions": 30,
      "GetWorkflows": 120,
      "GetActionEntities": 30
    },
    "DefaultTtlSeconds": 60
  },
  "FileService": {
    "BaseUrl": "http://file-service:8080"
  },
  "Gateway": {
    "Url": "http://localhost:8080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "workflow-service",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  },
  "LlmProviders": {
    "OpenAiCompatible": [
      {
        "Name": "OpenAI",
        "ApiKey": "",
        "ApiUrl": "https://api.openai.com/v1/chat/completions",
        "Model": "gpt-3.5-turbo"
      },
      {
        "Name": "GLM",
        "ApiKey": "",
        "ApiUrl": "https://api.z.ai/api/coding/paas/v4/chat/completions",
        "Model": "GLM-4.6"
      },
      {
        "Name": "FreeLlm",
        "ApiKey": "",
        "ApiUrl": "http://freellmapi-service:3001/v1/chat/completions",
        "Model": "auto"
      },
      {
        "Name": "LocalOllama or add your llm",
        "ApiKey": "",
        "ApiUrl": "http://localhost:11434/v1/chat/completions",
        "Model": "llama3"
      }
    ]
  }
}
