{
  "ReverseProxy": {
    "Routes": {
      "workflow-public-prompt": {
        "ClusterId": "workflow",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/workflow/public/workflow-ai/prompt" },
        "Transforms": [
          { "PathRemovePrefix": "/workflow" }
        ]
      },

      "workflow-route": {
        "ClusterId": "workflow",
        "AuthorizationPolicy": "workflow",
        "Match": { "Path": "/workflow/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/workflow" }
        ]
      },

      "client-route": {
        "ClusterId": "client",
        "AuthorizationPolicy": "client",
        "Match": { "Path": "/client/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/client" }
        ]
      },

      "telegram-route": {
        "ClusterId": "telegram",
        "AuthorizationPolicy": "telegram",
        "Match": { "Path": "/telegram/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },

      "telegram-hook-route": {
        "ClusterId": "telegram",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/telegram/hook/{**catch-all}",
          "Headers": [
            {
              "Name": "X-Telegram-Bot-Api-Secret-Token",
              "Values": [ "REPLACE_FROM_ENV" ],
              "Mode": "ExactHeader"
            }
          ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },
      
      "identity-token": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": {
          "Path": "/identity/connect/token"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },

      "identity-auth": {
        "ClusterId": "identity",
        "Order": 1,
        "Match": {
          "Path": "/identity/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      
      "identity-route": {
        "ClusterId": "identity",
        "Order": 100,
        "AuthorizationPolicy": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },

      "company-route": {
        "ClusterId": "company",
        "AuthorizationPolicy": "company",
        "Match": { "Path": "/company/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/company" }
        ]
      },
      "file-route": {
        "ClusterId": "file",
        "AuthorizationPolicy": "file",
        "Match": { "Path": "/file/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/file" }
        ]
      },

      "billing-webhook-route": {
        "ClusterId": "billing",
        "AuthorizationPolicy": "Anonymous",
        "Order": -2,
        "Match": { "Path": "/billing/webhook/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/billing" }
        ]
      },

      "billing-route": {
        "ClusterId": "billing",
        "AuthorizationPolicy": "billing",
        "Match": { "Path": "/billing/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/billing" }
        ]
      },

      "notification-route": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification",
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/notification" }
        ]
      },
      "sms-route": {
        "ClusterId": "sms",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/sms/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/sms" }
        ]
      }
    },

    "Clusters": {
      "workflow": {
        "Destinations": {
          "d1": { "Address": "http://workflow-service:8080/" }
        }
      },
      "client": {
        "Destinations": {
          "d1": { "Address": "http://client-service:8080/" }
        }
      },
      "telegram": {
        "Destinations": {
          "d1": { "Address": "http://telegram-service:8080/" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        }
      },
      "company": {
        "Destinations": {
          "d1": { "Address": "http://company-service:8080/" }
        }
      },
      "file": {
        "Destinations": {
          "d1": { "Address": "http://file-service:8080/" }
        }
      },
      "billing": {
        "Destinations": {
          "d1": { "Address": "http://billing-service:8080/" }
        }
      },
      "notification": {
        "Destinations": {
          "d1": { "Address": "http://notification-service:8080/" }
        }
      },
      "sms": {
        "Destinations": {
          "d1": { "Address": "http://sms-service:8080/" }
        }
      }
    }
  },
  "Observability": {
    "ServiceName": "gateway",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  },
  "OpenIddict": {
    "EncryptionKey": ""
  }
}
