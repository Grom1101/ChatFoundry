{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kafka": "kafka:9092"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "Services": {
    "WorkflowServiceUrl": "http://workflow-service:8081",
    "FileServiceUrl": "http://file-service:8081",
    "FileServiceRestUrl": "http://file-service:8080"
  },
  "Telegram": {
    "SecretToken": ""
  },
  "Gateway": {
    "Url": "http://localhost:8080"
  },
  "Observability": {
    "ServiceName": "telegram-service",
    "Seq": {
      "Url": "http://seq:5341"
    },
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    }
  }
}
