@using System.Text.Json
@using System.Text.RegularExpressions
@using WorkflowValidation
@inject IWorkflowApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<BlazorClient.Pages.WorkflowDesigner> LDesigner

@if (IsOpen)
{
    <div class="variables-modal-backdrop" @onclick="CloseAsync"></div>
    <div class="variables-modal">
        <div class="variables-modal-header">
            <h2 class="variables-modal-title">@LDesigner["AiDialogTitle"]</h2>
            <button type="button" class="variables-modal-close" @onclick="CloseAsync" aria-label="@LDesigner["CloseLabel"]" disabled="@AiBusy">
                <span class="oi oi-x"></span>
            </button>
        </div>
        <div class="variables-modal-body">
            @if (AiErrors.Count > 0)
            {
                <div class="alert alert-danger small mb-3" role="alert">
                    @foreach (var err in AiErrors)
                    {
                        <div>@err</div>
                    }
                </div>
            }
            <div class="mb-3">
                <div class="text-muted small mb-2">@LDesigner["AiDialogModeLabel"]</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="@(!AiMergeMode ? "designer-btn-primary" : "designer-btn-secondary")" @onclick="() => AiMergeMode = false" disabled="@AiBusy">@LDesigner["AiDialogModeNewBot"]</button>
                    <button type="button" class="@(AiMergeMode ? "designer-btn-primary" : "designer-btn-secondary")" @onclick="() => AiMergeMode = true" disabled="@AiBusy">@LDesigner["AiDialogModeMerge"]</button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">@LDesigner["AiDialogPromptLabel"]</label>
                <textarea class="form-control workflow-ai-dialog-textarea" rows="6" @bind="AiUserPrompt" @bind:event="oninput" disabled="@AiBusy" placeholder="@LDesigner["AiDialogPromptPlaceholder"]"></textarea>
            </div>
            <div class="mb-3 d-flex justify-content-end">
                <button type="button" class="designer-btn-primary" @onclick="GenerateFromAiAsync" disabled="@AiBusy">
                    @if (AiBusy)
                    {
                        <span>@LDesigner["AiDialogGenerating"]</span>
                    }
                    else
                    {
                        <span>@LDesigner["AiDialogGenerateBtn"]</span>
                    }
                </button>
            </div>
            <div class="mb-3 small">
                <div class="text-muted mb-1">@LDesigner["AiDialogInstructionLabel"]</div>
                <code class="d-block text-break user-select-all mb-2" style="font-size: 0.8rem;">@WorkflowAiPromptUrl</code>
                <button type="button" class="designer-btn-secondary me-2" @onclick="CopyAiPromptUrlAsync" disabled="@AiBusy">@LDesigner["AiDialogCopyLinkBtn"]</button>
                <button type="button" class="designer-btn-secondary" @onclick="DownloadAiInstructionAsync" disabled="@AiBusy">@LDesigner["AiDialogDownloadMdBtn"]</button>
            </div>
            <div class="mb-3">
                <label class="form-label">@LDesigner["AiDialogPasteJsonLabel"]</label>
                <textarea class="form-control font-monospace small workflow-ai-dialog-textarea-json" rows="8" @bind="AiPasteJson" @bind:event="oninput" disabled="@AiBusy" placeholder='{ "nodes": [ { "id": "00000000-0000... }'></textarea>
                <button type="button" class="designer-btn-secondary mt-2" @onclick="ApplyAiPasteJsonAsync" disabled="@AiBusy">@LDesigner["AiDialogApplyJsonBtn"]</button>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <button type="button" class="designer-btn-secondary" @onclick="CloseAsync" disabled="@AiBusy">@LDesigner["CloseLabel"]</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly JsonSerializerOptions WorkflowJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        WriteIndented = true
    };

    private static string WorkflowAiPromptUrl => $"{ApiEndpoints.Api}/workflow/public/workflow-ai/prompt";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Func<WorkflowSchema> GetCurrentSchema { get; set; } = null!;
    [Parameter] public Func<int> GetDiagramNodeCount { get; set; } = null!;
    [Parameter] public EventCallback<WorkflowSchema> OnSchemaApplied { get; set; }

    private string AiUserPrompt { get; set; } = "";
    private bool AiMergeMode { get; set; }
    private string AiPasteJson { get; set; } = "";
    private bool AiBusy { get; set; }
    private List<string> AiErrors { get; set; } = [];

    private async Task CloseAsync()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task CopyAiPromptUrlAsync()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", WorkflowAiPromptUrl);
    }

    private async Task DownloadAiInstructionAsync()
    {
        try
        {
            var md = await ApiClient.GetWorkflowAiInstructionMarkdownAsync();
            await JSRuntime.InvokeVoidAsync("window.__downloadWorkflowJson", "workflow-ai-instruction.md", md);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", string.Format(LDesigner["AiDialogDownloadError"].Value, ex.Message));
        }
    }

    private async Task GenerateFromAiAsync()
    {
        AiBusy = true;
        AiErrors.Clear();
        try
        {
            if (string.IsNullOrWhiteSpace(AiUserPrompt))
            {
                AiErrors.Add(LDesigner["AiDialogErrorEmptyPrompt"].Value);
                return;
            }

            if (AiMergeMode && GetDiagramNodeCount() == 0)
            {
                AiErrors.Add(LDesigner["AiDialogErrorNoNodesForMerge"].Value);
                return;
            }

            var current = AiMergeMode ? GetCurrentSchema() : null;
            var result = await ApiClient.GenerateWorkflowFromAiAsync(AiUserPrompt.Trim(), AiMergeMode, current);
            if (!result.Success)
            {
                AiErrors = LocalizeAiErrors(result.Errors);
                return;
            }

            if (string.IsNullOrWhiteSpace(result.WorkflowJson))
            {
                AiErrors.Add(LDesigner["AiDialogErrorEmptyResponse"].Value);
                return;
            }

            var localErrors = WorkflowSchemaValidator.Validate(result.WorkflowJson).ToList();
            if (localErrors.Count > 0)
            {
                AiErrors = localErrors;
                return;
            }

            var schema = JsonSerializer.Deserialize<WorkflowSchema>(result.WorkflowJson, WorkflowJsonOptions);
            if (schema == null)
            {
                AiErrors.Add(LDesigner["AiDialogErrorParseSchemaJson"].Value);
                return;
            }

            await OnSchemaApplied.InvokeAsync(schema);
            await IsOpenChanged.InvokeAsync(false);
        }
        finally
        {
            AiBusy = false;
            StateHasChanged();
        }
    }

    private async Task ApplyAiPasteJsonAsync()
    {
        AiErrors.Clear();
        try
        {
            if (string.IsNullOrWhiteSpace(AiPasteJson))
            {
                AiErrors.Add(LDesigner["AiDialogErrorEmptyJson"].Value);
                return;
            }

            var trimmed = AiPasteJson.Trim();
            var errs = WorkflowSchemaValidator.Validate(trimmed).ToList();
            if (errs.Count > 0)
            {
                AiErrors = errs;
                return;
            }

            var schema = JsonSerializer.Deserialize<WorkflowSchema>(trimmed, WorkflowJsonOptions);
            if (schema == null)
            {
                AiErrors.Add(LDesigner["AiDialogErrorParseJson"].Value);
                return;
            }

            await OnSchemaApplied.InvokeAsync(schema);
            AiPasteJson = "";
            await IsOpenChanged.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            AiErrors.Add(LocalizeAiError(ex.Message));
        }
    }

    private List<string> LocalizeAiErrors(IEnumerable<string>? errors)
    {
        var localized = errors?
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .Select(LocalizeAiError)
            .Distinct()
            .ToList() ?? [];

        if (localized.Count == 0)
            localized.Add(LDesigner["AiDialogErrorFallback"].Value);

        return localized;
    }

    private string LocalizeAiError(string rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return LDesigner["AiDialogErrorUnknown"].Value;

        var normalizedMessage = TryExtractAiServerError(rawMessage) ?? rawMessage;

        var quotaMatch = Regex.Match(
            normalizedMessage,
            @"Quota exceeded \(ai_builder\)\. Limit:\s*(\d+),\s*used:\s*(\d+)\.",
            RegexOptions.IgnoreCase);

        if (quotaMatch.Success)
        {
            var limit = quotaMatch.Groups[1].Value;
            var used = quotaMatch.Groups[2].Value;
            return string.Format(LDesigner["AiDialogErrorQuotaExceededWithDetails"].Value, used, limit);
        }

        if (normalizedMessage.Contains("Quota exceeded", StringComparison.OrdinalIgnoreCase))
            return LDesigner["AiDialogErrorQuotaExceeded"].Value;

        return normalizedMessage;
    }

    private string? TryExtractAiServerError(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return null;

        var jsonStart = message.IndexOf("{\"success\"", StringComparison.OrdinalIgnoreCase);
        if (jsonStart < 0)
            return null;

        var jsonPayload = message[jsonStart..];
        try
        {
            using var document = JsonDocument.Parse(jsonPayload);
            if (!document.RootElement.TryGetProperty("errors", out var errorsElement) ||
                errorsElement.ValueKind != JsonValueKind.Array ||
                errorsElement.GetArrayLength() == 0)
            {
                return null;
            }

            return errorsElement.EnumerateArray()
                .Select(item => item.GetString())
                .FirstOrDefault(item => !string.IsNullOrWhiteSpace(item));
        }
        catch
        {
            return null;
        }
    }
}
