@layout MainLayout
@inherits LayoutComponentBase

<div class="settings-layout">
    <aside class="settings-sidebar @(MobileMenuOpen ? "settings-sidebar--open" : "")">
        <div class="settings-sidebar-header">
            <div class="settings-sidebar-logo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                </svg>
            </div>
            <div class="settings-sidebar-title">
                <span class="settings-sidebar-name">@L["SettingsTitle"]</span>
                <span class="settings-sidebar-sub">@L["SettingsSubtitle"]</span>
            </div>
            <button class="settings-mobile-toggle" @onclick="ToggleMobileMenu">
                @if (MobileMenuOpen)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                }
            </button>
        </div>

        <nav class="settings-nav">
            <div class="settings-nav-section @(SectionCollapsed(0) ? "settings-nav-section--collapsed" : "")">
                <button class="settings-nav-label" @onclick="() => ToggleSection(0)">
                    <svg class="settings-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    <span>@L["SettingsSectionGeneral"]</span>
                </button>
                @if (_expandedSections.Contains(0))
                {
                    <div class="settings-nav-links">
                        <NavLink class="settings-nav-link" href="/settings" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--indigo">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsOverview"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/billing" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--amber">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsBilling"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/members" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--emerald">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsMembers"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/invitations" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--violet">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsInvitations"]</span>
                        </NavLink>
                    </div>
                }
            </div>

            <div class="settings-nav-section @(SectionCollapsed(1) ? "settings-nav-section--collapsed" : "")">
                <button class="settings-nav-label" @onclick="() => ToggleSection(1)">
                    <svg class="settings-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    <span>@L["SettingsSectionConfig"]</span>
                </button>
                @if (_expandedSections.Contains(1))
                {
                    <div class="settings-nav-links">
                        <NavLink class="settings-nav-link" href="/settings/channels" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--sky">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsChannels"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/attributes" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--orange">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsAttributes"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/files" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--rose">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsFiles"]</span>
                        </NavLink>
                    </div>
                }
            </div>

            <div class="settings-nav-section @(SectionCollapsed(2) ? "settings-nav-section--collapsed" : "")">
                <button class="settings-nav-label" @onclick="() => ToggleSection(2)">
                    <svg class="settings-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    <span>@L["SettingsSectionDev"]</span>
                </button>
                @if (_expandedSections.Contains(2))
                {
                    <div class="settings-nav-links">
                        <NavLink class="settings-nav-link" href="/settings/api" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--indigo">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">API</span>
                        </NavLink>
                    </div>
                }
            </div>

            <div class="settings-nav-section @(SectionCollapsed(3) ? "settings-nav-section--collapsed" : "")">
                <button class="settings-nav-label" @onclick="() => ToggleSection(3)">
                    <svg class="settings-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                    <span>@L["SettingsSectionMonitoring"]</span>
                </button>
                @if (_expandedSections.Contains(3))
                {
                    <div class="settings-nav-links">
                        <NavLink class="settings-nav-link" href="/settings/sessions" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--emerald">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsSessions"]</span>
                        </NavLink>
                        <NavLink class="settings-nav-link" href="/settings/analytics" @onclick="CloseMobileMenu">
                            <span class="settings-nav-icon settings-nav-icon--violet">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                                </svg>
                            </span>
                            <span class="settings-nav-text">@L["SettingsAnalytics"]</span>
                        </NavLink>
                    </div>
                }
            </div>
        </nav>
    </aside>
    <main class="settings-content">
        @Body
    </main>
</div>

@code {
    private bool MobileMenuOpen { get; set; }
    private HashSet<int> _expandedSections = [0, 1, 2, 3];

    private void ToggleMobileMenu()
    {
        MobileMenuOpen = !MobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        MobileMenuOpen = false;
    }

    private void ToggleSection(int index)
    {
        if (!_expandedSections.Remove(index))
            _expandedSections.Add(index);
    }

    private bool SectionCollapsed(int index) => !_expandedSections.Contains(index);
}
