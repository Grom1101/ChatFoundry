@page "/settings/members"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject ICompanyApiClient CompanyApi
@inject IStringLocalizer<Members> LMembers

<PageTitle>@LMembers["PageTitle"] — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <h1 class="settings-page-title">
            @LMembers["HeaderTitle"]
            @if (!isLoading && members.Any())
            {
                <span class="members-count">@members.Count</span>
            }
        </h1>
        <p class="settings-page-subtitle">@LMembers["HeaderSubtitle"]</p>
    </div>
</div>

@if (loadError != null)
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@loadError</span>
    </div>
}
@if (isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (!members.Any())
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div class="settings-empty-title">@LMembers["NoMembersTitle"]</div>
        <div class="settings-empty-desc">@LMembers["NoMembersDesc"]</div>
    </div>
}
else
{
    <div class="settings-card">
        <table class="settings-table">
            <thead>
            <tr>
                <th>@LMembers["ThMember"]</th>
                <th>@LMembers["ThRole"]</th>
                <th>@LMembers["ThStatus"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in members)
            {
                <tr>
                    <td>
                        <div class="member-row">
                            <div class="member-avatar">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <code class="member-id">@m.UserId.ToString("N")[..12]...</code>
                        </div>
                    </td>
                    <td>
                        <span class="settings-badge @RoleBadgeClass(m.Role)">@RoleLabel(m.Role)</span>
                    </td>
                    <td>
                        @if (m.IsActive)
                        {
                            <span class="member-status member-status-active">
                                <span class="member-status-dot"></span>
                                @LMembers["StatusActive"]
                            </span>
                        }
                        else
                        {
                            <span class="member-status member-status-inactive">@LMembers["StatusInactive"]</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CompanyMemberDto> members = new();
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        isLoading = true;
        loadError = null;
        try
        {
            members = await CompanyApi.GetMembersAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string RoleBadgeClass(string? role) => role?.ToUpperInvariant() switch
    {
        "OWNER" => "settings-badge-primary",
        "ADMIN" => "settings-badge-warning",
        _ => "settings-badge-neutral"
    };

    private string RoleLabel(string? role) => role?.ToUpperInvariant() switch
    {
        "OWNER" => LMembers["RoleOwner"],
        "ADMIN" => LMembers["RoleAdmin"],
        "MEMBER" => LMembers["RoleMember"],
        _ => role ?? "—"
    };
}
