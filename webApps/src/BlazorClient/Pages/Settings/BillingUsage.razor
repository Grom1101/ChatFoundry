@page "/settings/billing/usage"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IBillingApiClient Billing
@inject IStringLocalizer<BillingUsage> LUsage

<PageTitle>@LUsage["PageTitle"]</PageTitle>

<div class="settings-page-header">
    <div>
        <a class="billing-back-link" href="/settings/billing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            @LUsage["BackToBilling"]
        </a>
        <h1 class="settings-page-title">@LUsage["HeaderTitle"]</h1>
        <p class="settings-page-subtitle">@LUsage["HeaderSubtitle"]</p>
    </div>
</div>

@if (loadError != null)
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@loadError</span>
    </div>
}
else if (isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (_overview == null)
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div class="settings-empty-title">@LUsage["EmptyTitle"]</div>
        <div class="settings-empty-desc">@LUsage["EmptyDesc"]</div>
    </div>
}
else
{
    <!-- AI Usage cards -->
    <div class="settings-stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <div class="settings-card billing-usage-detail-card">
            <div class="settings-card-body">
                <div class="billing-usage-detail-header">
                    <div class="billing-usage-detail-icon" style="background: #eef2ff;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    </div>
                    <div>
                        <div class="billing-usage-detail-title">@LUsage["AiTokensTitle"]</div>
                        <div class="billing-usage-detail-sub">@LUsage["AiTokensDesc"]</div>
                    </div>
                </div>
                <div class="billing-usage-detail-bar-wrap">
                    <div class="billing-usage-detail-bar-info">
                        <span class="billing-usage-detail-used">@FormatTokens(_overview.AiTokensUsed)</span>
                        <span class="billing-usage-detail-max">@LUsage["FromMax", FormatTokens(_overview.MaxAiTokens)]</span>
                    </div>
                    <div class="billing-usage-progress">
                        <div class="billing-usage-progress-bar" style="width: @UsagePercent(_overview.AiTokensUsed, _overview.MaxAiTokens)%; background: @UsageColor(_overview.AiTokensUsed, _overview.MaxAiTokens);"></div>
                    </div>
                </div>
                <div class="billing-usage-detail-percent">
                    <span style="color: @UsageColor(_overview.AiTokensUsed, _overview.MaxAiTokens);">@UsagePercent(_overview.AiTokensUsed, _overview.MaxAiTokens)%</span>
                    @LUsage["UsedText"]
                </div>
            </div>
        </div>
    </div>

    <!-- Resource limits table -->
    <div class="settings-card" style="margin-top: 1rem;">
        <div class="settings-card-body">
            <h3 class="billing-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                @LUsage["ResourceLimitsTitle"]
            </h3>
            <div class="billing-resources-grid">
                <div class="billing-resource-item">
                    <div class="billing-resource-icon" style="background: #ecfdf5;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    </div>
                    <div class="billing-resource-info">
                        <div class="billing-resource-name">@LUsage["ClientsTitle"]</div>
                        <div class="billing-resource-desc">@LUsage["ClientsDesc"]</div>
                    </div>
                    <div class="billing-resource-value">@FormatCount(_overview.MaxClients)</div>
                </div>
                <div class="billing-resource-item">
                    <div class="billing-resource-icon" style="background: #eef2ff;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                    </div>
                    <div class="billing-resource-info">
                        <div class="billing-resource-name">@LUsage["BotsTitle"]</div>
                        <div class="billing-resource-desc">@LUsage["BotsDesc"]</div>
                    </div>
                    <div class="billing-resource-value">@FormatCount(_overview.MaxBots)</div>
                </div>
                <div class="billing-resource-item">
                    <div class="billing-resource-icon" style="background: #faf5ff;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                    </div>
                    <div class="billing-resource-info">
                        <div class="billing-resource-name">@LUsage["MembersTitle"]</div>
                        <div class="billing-resource-desc">@LUsage["MembersDesc"]</div>
                    </div>
                    <div class="billing-resource-value">@_overview.MaxTeamMembers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="settings-alert settings-alert-info" style="margin-top: 1rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>@LUsage["AnalyticsNotice"]</span>
    </div>
}

@code {
    private BillingOverviewDto? _overview;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _overview = await Billing.GetBillingOverviewAsync();
        }
        catch (Exception ex)
        {
            loadError = string.Format(LUsage["LoadError"], ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatCount(long max) => max >= long.MaxValue - 1000 || max >= int.MaxValue - 1000 ? "∞" : max.ToString();

    private static string FormatTokens(long value) => value switch
    {
        >= 1_000_000_000 => $"{value / 1_000_000_000.0:F1}B",
        >= 1_000_000 => $"{value / 1_000_000.0:F1}M",
        >= 1_000 => $"{value / 1_000.0:F1}K",
        _ => value.ToString()
    };

    private static string UsagePercent(long used, long max) =>
        max >= long.MaxValue - 1000 || max >= int.MaxValue - 1000 ? "0" : Math.Min(100, (int)((double)used / max * 100)).ToString();

    private static string UsageColor(long used, long max) =>
        max >= long.MaxValue - 1000 || max >= int.MaxValue - 1000 ? "#6366f1" :
        (double)used / max > 0.9 ? "#ef4444" :
        (double)used / max > 0.7 ? "#f59e0b" : "#6366f1";
}
