@page "/settings/billing/top-up"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IStringLocalizer<BillingTopUp> LTopUp

<PageTitle>@LTopUp["PageTitle"] вЂ” ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <a class="billing-back-link" href="/settings/billing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            @LTopUp["BackToBilling"]
        </a>
        <h1 class="settings-page-title">@LTopUp["HeaderTitle"]</h1>
        <p class="settings-page-subtitle">@LTopUp["HeaderSubtitle"]</p>
    </div>
</div>

<div class="billing-topup-layout">
    <div class="settings-card billing-topup-card" style="grid-column: span 2;">
        <div class="settings-card-body" style="text-align: center; padding: 3rem 2rem;">
            <div class="billing-topup-icon" style="margin: 0 auto 1.5rem; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: #eef2ff; border-radius: 50%;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            </div>
            <h3 class="billing-topup-title" style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem;">@LTopUp["ManualTopUpTitle"]</h3>
            <p class="billing-topup-desc" style="max-width: 500px; margin: 0 auto 2rem; color: var(--text-muted); line-height: 1.6;">
                @LTopUp["ManualTopUpDesc"]
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="https://t.me/Odins0n" target="_blank" rel="noopener" class="settings-btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.75rem 1.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    @LTopUp["LinkTelegram"]
                </a>
                <a href="mailto:gromdev1101@gmail.com" class="settings-btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.75rem 1.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    @LTopUp["LinkEmail"]
                </a>
                <a href="/settings/billing" class="settings-btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.75rem 1.5rem;">
                    @LTopUp["LinkBack"]
                </a>
            </div>
        </div>
    </div>
</div>
