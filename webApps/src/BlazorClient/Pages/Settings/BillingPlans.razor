@page "/settings/billing/plans"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IBillingApiClient Billing
@inject NavigationManager Nav
@inject IStringLocalizer<BillingPlans> LPlans

<PageTitle>@LPlans["PageTitle"] — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <a class="billing-back-link" href="/settings/billing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            @LPlans["BackToBilling"]
        </a>
        <h1 class="settings-page-title">@LPlans["HeaderTitle"]</h1>
        <p class="settings-page-subtitle">@LPlans["HeaderSubtitle"]</p>
    </div>
</div>

<div class="billing-plan-info">
    <div class="billing-plan-info-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span><strong>@LPlans["UpgradePlan"]</strong>@LPlans["UpgradeDesc"]</span>
    </div>
    <div class="billing-plan-info-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span><strong>@LPlans["DowngradePlan"]</strong>@LPlans["DowngradeDesc"]</span>
    </div>
    <div class="billing-plan-info-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        <span>@LPlans["CreditNote"]</span>
    </div>
</div>

@if (loadError != null)
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@loadError</span>
    </div>
}
else if (isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (_plans == null || !_plans.Any())
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div class="settings-empty-title">@LPlans["EmptyTitle"]</div>
        <div class="settings-empty-desc">@LPlans["EmptyDesc"]</div>
    </div>
}
else
{
    <div class="billing-plans-grid">
        @foreach (var plan in _plans)
        {
            var isCurrent = plan.Slug.Equals(_currentPlan, StringComparison.OrdinalIgnoreCase);
            var isPending = !isCurrent && plan.Slug.Equals(_pendingPlanSlug, StringComparison.OrdinalIgnoreCase);

            <div class="billing-plan @((isCurrent ? "billing-plan-current" : ""))">
                @if (isCurrent)
                {
                    <div class="billing-plan-badge">@LPlans["BadgeCurrent"]</div>
                }
                else if (isPending && _pendingChangeAt.HasValue)
                {
                    <div class="billing-plan-badge billing-plan-badge-pending">
                        @string.Format(LPlans["BadgePending"], _pendingChangeAt.Value.ToString("dd MMM yyyy"))
                    </div>
                }
                <div class="billing-plan-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (plan.Slug.Equals("enterprise", StringComparison.OrdinalIgnoreCase))
                        {
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        }
                        else if (plan.Slug.Equals("pro", StringComparison.OrdinalIgnoreCase) || plan.Slug.Equals("business", StringComparison.OrdinalIgnoreCase))
                        {
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
                        }
                    </svg>
                </div>
                <h3 class="billing-plan-name">@plan.Name</h3>
                <div class="billing-plan-price">
                    <span class="billing-plan-amount">$@plan.PricePerMonth</span>
                    <span class="billing-plan-period">@LPlans["PriceSuffix"]</span>
                </div>
                <div class="billing-plan-divider"></div>
                <ul class="billing-plan-features">
                    <li>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@string.Format(LPlans["FeatureClients"], FormatCount(plan.MaxClients))</span>
                    </li>
                    <li>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@string.Format(LPlans["FeatureBots"], FormatCount(plan.MaxBots))</span>
                    </li>
                    <li>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@string.Format(LPlans["FeatureTeam"], plan.MaxTeamMembers)</span>
                    </li>
                    <li>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@string.Format(LPlans["FeatureAiTokens"], FormatTokens(plan.MaxAiTokens))</span>
                        <span class="billing-tooltip-wrap">
                            <svg class="billing-tooltip-trigger" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            <span class="billing-tooltip">@LPlans["TooltipAiTokens"]</span>
                        </span>
                    </li>
                    @if (plan.HasAnalytics)
                    {
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>@LPlans["FeatureAnalytics"]</span>
                        </li>
                    }
                    @if (plan.HasApiAccess)
                    {
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>@LPlans["FeatureApiAccess"]</span>
                        </li>
                    }
                </ul>
                @if (isCurrent)
                {
                    @if (_pendingPlanSlug != null)
                    {
                        <button class="billing-plan-btn billing-plan-btn-cancel" @onclick="() => SelectPlan(plan.Slug)" disabled="@_busy">
                            @LPlans["BtnCancelChange"]
                        </button>
                    }
                    else
                    {
                        <button class="billing-plan-btn billing-plan-btn-active" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            @LPlans["BtnActive"]
                        </button>
                    }
                }
                else if (isPending)
                {
                    <button class="billing-plan-btn billing-plan-btn-pending" disabled>
                        @LPlans["BtnPending"]
                    </button>
                }
                else
                {
                    <button class="billing-plan-btn" @onclick="() => SelectPlan(plan.Slug)" disabled="@_busy">
                        @LPlans["BtnSelect"]
                    </button>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="settings-alert @(isSuccess ? "settings-alert-success" : "settings-alert-danger")" style="margin-top: 1.5rem;">
            <span>@_msg</span>
        </div>
    }
}

@code {
    private IReadOnlyList<SubscriptionPlanDto>? _plans;
    private bool isLoading = true;
    private bool _busy;
    private bool isSuccess;
    private string? _msg;
    private string? loadError;
    private string _currentPlan = "";
    private string? _pendingPlanSlug;
    private DateTime? _pendingChangeAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var plansTask = Billing.GetSubscriptionPlansAsync();
            var overviewTask = Billing.GetBillingOverviewAsync();
            await Task.WhenAll(plansTask, overviewTask);
            _plans = await plansTask;
            var overview = await overviewTask;
            _currentPlan = overview?.PlanSlug ?? "";
            _pendingPlanSlug = overview?.PendingPlanSlug;
            _pendingChangeAt = overview?.PendingChangeAt;
        }
        catch (Exception ex)
        {
            loadError = string.Format(LPlans["LoadError"], ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectPlan(string slug)
    {
        _busy = true;
        _msg = null;
        isSuccess = false;
        try
        {
            var result = await Billing.ChangeSubscriptionPlanAsync(slug);
            if (result == null)
            {
                _msg = LPlans["ChangePlanFailed"];
                return;
            }

            switch (result.ResultType)
            {
                case "UpgradeApplied":
                    isSuccess = true;
                    _msg = result.CreditApplied.HasValue
                        ? string.Format(LPlans["UpgradeSuccessCredit"], slug, result.CreditApplied.Value)
                        : string.Format(LPlans["UpgradeSuccess"], slug);
                    _currentPlan = slug;
                    _pendingPlanSlug = null;
                    _pendingChangeAt = null;
                    break;

                case "DowngradeScheduled":
                    isSuccess = true;
                    _pendingPlanSlug = slug;
                    _pendingChangeAt = result.PendingChangeAt;
                    _msg = string.Format(LPlans["DowngradeSuccess"], slug, _pendingChangeAt);
                    break;

                case "ClearedPending":
                    isSuccess = true;
                    _pendingPlanSlug = null;
                    _pendingChangeAt = null;
                    _msg = LPlans["ChangeCancelled"];
                    break;

                default:
                    _msg = LPlans["CurrentPlanSelected"];
                    break;
            }
        }
        catch (Exception ex)
        {
            _msg = ex.Message.Contains("Insufficient balance", StringComparison.OrdinalIgnoreCase)
                ? LPlans["InsufficientBalance"].Value
                : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatCount(long max) => max >= long.MaxValue - 1000 || max >= int.MaxValue - 1000 ? "∞" : max.ToString();

    private static string FormatTokens(long value) => value switch
    {
        >= 1_000_000_000 => $"{value / 1_000_000_000.0:F1}B",
        >= 1_000_000 => $"{value / 1_000_000.0:F1}M",
        >= 1_000 => $"{value / 1_000.0:F1}K",
        _ => value.ToString()
    };
}
