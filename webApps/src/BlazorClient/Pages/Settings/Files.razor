@page "/settings/files"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization
@using System.Threading
@attribute [Authorize]
@implements IDisposable

@inject IFileApiClient FileApi
@inject ICompanyApiClient CompanyApi
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Files> LFiles

<PageTitle>@LFiles["PageTitle"] — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <h1 class="settings-page-title">@LFiles["HeaderTitle"]</h1>
        <p class="settings-page-subtitle">@LFiles["HeaderSubtitle"]</p>
    </div>
    <button class="settings-btn-primary" @onclick="() => showUploadModal = true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        @LFiles["BtnUploadFile"]
    </button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@error</span>
        <button style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;opacity:0.6;" @onclick="() => error = null">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}

@if (isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (!_allFiles.Any())
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
        </div>
        <div class="settings-empty-title">@LFiles["NoFilesTitle"]</div>
        <div class="settings-empty-desc">@LFiles["NoFilesDesc"]</div>
        <button class="settings-btn-primary" @onclick="() => showUploadModal = true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            @LFiles["BtnUploadFile"]
        </button>
    </div>
}
else
{
    var (pageItems, totalFiltered) = GetPage();
    <div class="settings-card files-card">
        <div class="files-filters">
            <div class="files-filters-row">
                <input type="text" class="files-input files-input-search" placeholder="@LFiles["SearchPlaceholder"]" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchInput" />
                <select class="settings-select files-select" @bind="_typeFilter" @bind:after="OnFilterChanged">
                    <option value="">@LFiles["FilterAllTypes"]</option>
                    <option value="image">@LFiles["FilterImages"]</option>
                    <option value="video">@LFiles["FilterVideo"]</option>
                    <option value="audio">@LFiles["FilterAudio"]</option>
                    <option value="other">@LFiles["FilterOther"]</option>
                </select>
                <button type="button" class="settings-icon-btn files-btn-refresh" @onclick="OnRefreshClick" title="@LFiles["TooltipRefresh"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                </button>
            </div>
            <div class="files-filters-row files-filters-row-dates">
                <span class="files-filter-label">@LFiles["FilterUploadedLabel"]</span>
                <input type="date" class="files-input files-input-date" @bind="_createdFrom" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
                <span class="files-filter-sep">—</span>
                <input type="date" class="files-input files-input-date" @bind="_createdTo" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
            </div>
        </div>
        @if (totalFiltered == 0)
        {
            <div class="files-filter-empty">
                <p>@LFiles["FilterEmptyText"]</p>
                <small>@LFiles["FilterEmptyHint"]</small>
            </div>
        }
        else
        {
        <table class="settings-table">
            <thead>
            <tr>
                <th>@LFiles["ThFile"]</th>
                <th>@LFiles["ThType"]</th>
                <th>@LFiles["ThSize"]</th>
                <th>@LFiles["ThDate"]</th>
                <th>@LFiles["ThUploader"]</th>
                <th style="text-align: right;">@LFiles["ThActions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var file in pageItems)
            {
                <tr style="cursor: pointer;" @onclick="() => OpenFile(file)">
                    <td>
                        <div class="file-name-row">
                            <div class="file-icon @FileIconClass(file.ContentType)">
                                @if (IsImage(file.ContentType))
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                }
                                else if (IsVideo(file.ContentType))
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                                }
                                else if (IsAudio(file.ContentType))
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                                }
                            </div>
                            <span class="file-name">@(file.Name ?? "—")</span>
                        </div>
                    </td>
                    <td><code class="file-type">@(file.ContentType ?? "—")</code></td>
                    <td class="file-size">@FormatSize(file.Size)</td>
                    <td class="file-date">@(file.CreatedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td class="file-source">@(file.UploadedByUserId.HasValue ? LFiles["SourceAdmin"] : LFiles["SourceClient"])</td>
                    <td style="text-align: right;" @onclick:stopPropagation="true">
                        <div class="file-actions">
                            <button class="settings-icon-btn" @onclick="() => OpenFile(file)" title="@LFiles["TooltipDetails"]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                            <button class="settings-icon-btn" @onclick="() => DownloadFile(file)" title="@LFiles["TooltipDownload"]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            </button>
                            <button class="settings-icon-btn settings-icon-btn-danger" @onclick="() => DeleteFile(file)" title="@LFiles["TooltipDelete"]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>

    @if (totalFiltered > 0)
    {
        <div class="files-pagination">
            <div class="files-pagination-info">
                <span class="files-pagination-muted">@string.Format(LFiles["PaginationInfo"].Value, pageItems.Count, totalFiltered)</span>
            </div>
            <div class="files-pagination-controls">
                <label class="files-pagination-muted">@LFiles["PaginationOnPage"]</label>
                <select class="files-page-size" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <button class="files-btn-page" disabled="@(!HasPrevPage)" @onclick="GoToPreviousPage" title="@LFiles["PaginationPrev"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="files-btn-page" disabled="@(!HasNextPage)" @onclick="GoToNextPage" title="@LFiles["PaginationNext"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>
    }
}

@if (showUploadModal)
{
    <div class="settings-modal-backdrop" @onclick="@(() => { if (!isUploading) CloseUploadModal(); })"></div>
    <div class="settings-modal">
        <div class="settings-modal-header">
            <h3 class="settings-modal-title">@LFiles["ModalUploadTitle"]</h3>
            <button class="settings-modal-close" @onclick="CloseUploadModal" disabled="@isUploading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="settings-modal-body">
            <div class="settings-field">
                <label class="settings-label">@LFiles["ModalUploadSelectLabel"]</label>
                <InputFile class="settings-input" OnChange="OnFileSelected" disabled="@isUploading" style="padding: 8px;" />
            </div>
            @if (selectedFile != null)
            {
                <div class="upload-file-info">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                    <strong>@selectedFile.Name</strong> — @FormatSize(selectedFile.Size)
                </div>
            }
            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="settings-alert settings-alert-danger" style="margin-bottom: 0;">
                     <span>@uploadError</span>
                </div>
            }
        </div>
        <div class="settings-modal-footer">
            <button class="settings-btn-secondary" @onclick="CloseUploadModal" disabled="@isUploading">@LFiles["ModalUploadCancel"]</button>
            <button class="settings-btn-primary" @onclick="UploadFile" disabled="@(isUploading || selectedFile == null)">
                @if (isUploading) { <div class="settings-spinner" style="width:16px;height:16px;border-width:2px;"></div> }
                @LFiles["ModalUploadBtn"]
            </button>
        </div>
    </div>
}

@code {
    private List<FileInfoDto> _allFiles = new();
    private bool isLoading = true;
    private string? error;

    private string _searchText = "";
    private DateTime? _createdFrom;
    private DateTime? _createdTo;
    private string _typeFilter = "";
    private int _pageSize = 25;
    private int _pageIndex;
    private Timer? _searchDebounceTimer;

    private bool showUploadModal;
    private bool isUploading;
    private string? uploadError;
    private IBrowserFile? selectedFile;

    private const long MaxFileSize = 20 * 1024 * 1024;

    private bool HasPrevPage => _pageIndex > 0;

    private bool HasNextPage
    {
        get
        {
            var total = ComputeFiltered().Count;
            return (_pageIndex + 1) * _pageSize < total;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
    }

    private List<FileInfoDto> ComputeFiltered()
    {
        var q = (IEnumerable<FileInfoDto>)_allFiles;

        var search = _searchText.Trim();
        if (!string.IsNullOrEmpty(search))
        {
            q = q.Where(f =>
                (f.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) == true) ||
                f.Id.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(_typeFilter))
        {
            q = q.Where(f => _typeFilter switch
            {
                "image" => IsImage(f.ContentType),
                "video" => IsVideo(f.ContentType),
                "audio" => IsAudio(f.ContentType),
                "other" => !IsImage(f.ContentType) && !IsVideo(f.ContentType) && !IsAudio(f.ContentType),
                _ => true
            });
        }

        if (_createdFrom.HasValue)
        {
            var from = _createdFrom.Value.Date;
            q = q.Where(f => f.CreatedAt.HasValue && f.CreatedAt.Value.ToLocalTime().Date >= from);
        }

        if (_createdTo.HasValue)
        {
            var to = _createdTo.Value.Date;
            q = q.Where(f => f.CreatedAt.HasValue && f.CreatedAt.Value.ToLocalTime().Date <= to);
        }

        return q.OrderByDescending(f => f.CreatedAt).ToList();
    }

    private (List<FileInfoDto> page, int total) GetPage()
    {
        var filtered = ComputeFiltered();
        var total = filtered.Count;
        if (_pageIndex > 0 && _pageIndex * _pageSize >= total)
            _pageIndex = Math.Max(0, (total - 1) / Math.Max(_pageSize, 1));
        var page = filtered.Skip(_pageIndex * _pageSize).Take(_pageSize).ToList();
        return (page, total);
    }

    private void OnFilterChanged()
    {
        _pageIndex = 0;
    }

    private async Task OnSearchInput()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                _searchDebounceTimer?.Dispose();
                _searchDebounceTimer = null;
                _pageIndex = 0;
                await InvokeAsync(StateHasChanged);
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task OnRefreshClick()
    {
        _pageIndex = 0;
        await LoadFiles();
    }

    private void OnPageSizeChanged()
    {
        _pageIndex = 0;
    }

    private Task GoToNextPage()
    {
        if (HasNextPage)
            _pageIndex++;
        return InvokeAsync(StateHasChanged);
    }

    private Task GoToPreviousPage()
    {
        if (HasPrevPage)
            _pageIndex--;
        return InvokeAsync(StateHasChanged);
    }

    private async Task LoadFiles()
    {
        isLoading = true;
        error = null;
        try
        {
            _allFiles = await FileApi.ListFilesAsync();
            _pageIndex = 0;
        }
        catch (Exception ex)
        {
            error = string.Format(LFiles["ErrorLoad"].Value, ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
    }

    private void OpenFile(FileInfoDto file)
    {
        Navigation.NavigateTo($"/settings/files/{file.Id}");
    }

    private async Task DownloadFile(FileInfoDto file)
    {
        if (string.IsNullOrEmpty(file.Key)) return;
        try
        {
            var url = await FileApi.GetDownloadUrlAsync(file.Key, forceDownload: true);
            if (!string.IsNullOrEmpty(url))
                await JsRuntime.InvokeVoidAsync("__triggerFileDownload", url);
        }
        catch (Exception ex)
        {
            error = string.Format(LFiles["ErrorDownload"].Value, ex.Message);
        }
    }

    private async Task DeleteFile(FileInfoDto file)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", string.Format(LFiles["DeleteConfirm"].Value, file.Name)))
            return;

        error = null;
        try
        {
            await FileApi.DeleteFileAsync(Guid.Parse(file.Id));
            await LoadFiles();
        }
        catch (Exception ex)
        {
            error = string.Format(LFiles["ErrorDelete"].Value, ex.Message);
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        selectedFile = e.File;
        if (selectedFile.Size > MaxFileSize)
        {
            uploadError = LFiles["ErrorFileTooLarge"];
            selectedFile = null;
        }
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        isUploading = true;
        uploadError = null;
        try
        {
            var company = await CompanyApi.GetCurrentCompanyAsync();
            await using var stream = selectedFile.OpenReadStream(MaxFileSize);
            var result = await FileApi.UploadFileAsync(stream, selectedFile.Name, selectedFile.ContentType, company?.Id);
            if (result == null)
            {
                uploadError = LFiles["ErrorUploadFailed"];
                return;
            }
            CloseUploadModal();
            await LoadFiles();
        }
        catch (Exception ex)
        {
            uploadError = string.Format(LFiles["ErrorLoad"].Value, ex.Message);
        }
        finally
        {
            isUploading = false;
        }
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        uploadError = null;
        selectedFile = null;
    }

    private static bool IsImage(string? ct) => ct?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsVideo(string? ct) => ct?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsAudio(string? ct) => ct?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true;

    private static string FileIconClass(string? ct)
    {
        if (IsImage(ct)) return "file-icon-image";
        if (IsVideo(ct)) return "file-icon-video";
        if (IsAudio(ct)) return "file-icon-audio";
        return "file-icon-default";
    }

    private string FormatSize(long? bytes)
    {
        if (bytes is null) return "—";
        var b = bytes.Value;
        if (b < 1024) return string.Format(LFiles["FormatSizeB"].Value, b);
        if (b < 1024 * 1024) return string.Format(LFiles["FormatSizeKB"].Value, b / 1024.0);
        if (b < 1024L * 1024 * 1024) return string.Format(LFiles["FormatSizeMB"].Value, b / (1024.0 * 1024));
        return string.Format(LFiles["FormatSizeGB"].Value, b / (1024.0 * 1024 * 1024));
    }
}
