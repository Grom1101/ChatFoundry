@page "/settings/sessions"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable

@inject BlazorClient.Interfaces.IWorkflowApiClient ApiClient
@inject NavigationManager Navigation
@inject IStringLocalizer<Sessions> LSessions

<PageTitle>@LSessions["PageTitle"] — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <h1 class="settings-page-title">@LSessions["HeaderTitle"]</h1>
        <p class="settings-page-subtitle">@LSessions["HeaderSubtitle"]</p>
    </div>
</div>

@if (_isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
        <button style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;opacity:0.6;" @onclick="() => _error = null">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}
else if (!_sessions.Any() && !HasActiveFilters)
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <div class="settings-empty-title">@LSessions["NoSessions"]</div>
        <div class="settings-empty-desc">@LSessions["NoSessionsDesc"]</div>
    </div>
}
else
{
    <div class="settings-card sess-card">
        <div class="sess-filters">
            <div class="sess-filters-row">
                <input type="text" class="sess-input sess-input-search" placeholder="@LSessions["ClientIdPlaceholder"]" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchInput" />
                <select class="settings-select sess-select" @bind="StatusFilter" @bind:after="OnFilterChanged">
                    <option value="">@LSessions["AllStatuses"]</option>
                    <option value="ACTIVE">@LSessions["StatusActive"]</option>
                    <option value="COMPLETED">@LSessions["StatusCompleted"]</option>
                    <option value="FAILED">@LSessions["StatusFailed"]</option>
                    <option value="CANCELLED">@LSessions["StatusCancelled"]</option>
                </select>
                <select class="settings-select sess-select" @bind="_botIdFilter" @bind:after="OnFilterChanged">
                    <option value="">@LSessions["AllBots"]</option>
                    @foreach (var bot in _bots)
                    {
                        <option value="@bot.Id">@bot.Name</option>
                    }
                </select>
                <button type="button" class="settings-icon-btn sess-btn-refresh" @onclick="OnRefreshClick" title="@LSessions["Refresh"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                </button>
            </div>
            <div class="sess-filters-row sess-filters-row-dates">
                <span class="sess-filter-label">@LSessions["Created"]</span>
                <input type="date" class="sess-input sess-input-date" @bind="_createdFrom" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
                <span class="sess-filter-sep">—</span>
                <input type="date" class="sess-input sess-input-date" @bind="_createdTo" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
                <span class="sess-filter-label">@LSessions["CompletedLabel"]</span>
                <input type="date" class="sess-input sess-input-date" @bind="_completedFrom" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
                <span class="sess-filter-sep">—</span>
                <input type="date" class="sess-input sess-input-date" @bind="_completedTo" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChanged" />
            </div>
        </div>
        @if (!_sessions.Any())
        {
            <div class="sess-filter-empty">
                <p>@LSessions["NotFound"]</p>
                <small>@LSessions["ChangeFilters"]</small>
            </div>
        }
        else
        {
            <table class="settings-table">
                <thead>
                <tr>
                    <th>@LSessions["ColClient"]</th>
                    <th>@LSessions["ColBot"]</th>
                    <th>@LSessions["ColChannel"]</th>
                    <th>@LSessions["ColStatus"]</th>
                    <th>@LSessions["ColSteps"]</th>
                    <th>@LSessions["ColCreated"]</th>
                    <th style="text-align: right;"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td>
                            <code class="sess-client-id">@TruncateClientId(s.ClientId)</code>
                        </td>
                        <td>
                            <div class="sess-bot-info">
                                <span class="sess-bot-name">@(s.Workflow?.Bot?.Name ?? "—")</span>
                                <span class="sess-bot-version">v@(s.Workflow?.Version ?? 0)</span>
                            </div>
                        </td>
                        <td>
                            <span class="settings-badge settings-badge-neutral">@FormatChannel(s.Channel)</span>
                        </td>
                        <td>
                            <span class="settings-badge @StatusBadgeClass(s.Status)">@StatusLabel(s.Status)</span>
                        </td>
                        <td>
                            <span class="sess-step-count">@(s.Actions?.Count ?? 0)</span>
                        </td>
                        <td>
                            <div class="sess-date-cell">
                                <span>@s.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                @if (s.CompletedAt.HasValue)
                                {
                                    <span class="sess-date-completed">→ @s.CompletedAt.Value.ToLocalTime().ToString("HH:mm")</span>
                                }
                            </div>
                        </td>
                        <td style="text-align: right;">
                            <button class="settings-btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;" @onclick="() => OpenReplay(s.Id)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                                @LSessions["BtnPath"]
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    @if (_totalCount > 0)
    {
        <div class="sess-pagination">
            <div class="sess-pagination-info">
                <span class="sess-pagination-muted">@string.Format(LSessions["ShownCountOfTotal"], _sessions.Count, _totalCount)</span>
            </div>
            <div class="sess-pagination-controls">
                <label class="sess-pagination-muted">@LSessions["OnPage"]</label>
                <select class="sess-page-size" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <button class="sess-btn-page" disabled="@(!_hasPreviousPage)" @onclick="GoToPreviousPage" title="@LSessions["Back"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="sess-btn-page" disabled="@(!_hasNextPage)" @onclick="GoToNextPage" title="@LSessions["Next"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>
    }
}

@code {
    private List<SessionDto> _sessions = [];
    private List<BotDto> _bots = [];
    private bool _isLoading = true;
    private string? _error;
    private string StatusFilter { get; set; } = "";
    private string _searchText = "";
    private string _botIdFilter = "";
    private DateTime? _createdFrom;
    private DateTime? _createdTo;
    private DateTime? _completedFrom;
    private DateTime? _completedTo;

    private int _pageSize = 25;
    private string? _endCursor;
    private readonly List<string> _cursorStack = [];
    private bool _hasNextPage;
    private bool _hasPreviousPage;
    private int _totalCount;
    private Timer? _searchDebounceTimer;
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(StatusFilter) ||
        !string.IsNullOrWhiteSpace(_searchText) ||
        !string.IsNullOrWhiteSpace(_botIdFilter) ||
        _createdFrom.HasValue ||
        _createdTo.HasValue ||
        _completedFrom.HasValue ||
        _completedTo.HasValue;

    protected override async Task OnInitializedAsync()
    {
        try { _bots = await ApiClient.GetBotsAsync(); } catch {  }
        await LoadSessions();
    }

    private SessionListFilter? BuildFilter()
    {
        var status = string.IsNullOrWhiteSpace(StatusFilter) ? null : StatusFilter.Trim().ToUpperInvariant();
        var search = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
        Guid? botId = null;
        if (!string.IsNullOrWhiteSpace(_botIdFilter) && Guid.TryParse(_botIdFilter, out var bid))
            botId = bid;

        var createdToEnd = _createdTo.HasValue ? _createdTo.Value.Date.AddDays(1).AddTicks(-1) : (DateTime?)null;
        var completedToEnd = _completedTo.HasValue ? _completedTo.Value.Date.AddDays(1).AddTicks(-1) : (DateTime?)null;

        if (status == null && search == null && !botId.HasValue && !_createdFrom.HasValue && !_createdTo.HasValue && !_completedFrom.HasValue && !_completedTo.HasValue)
            return null;

        return new SessionListFilter
        {
            Status = status,
            Search = search,
            BotId = botId,
            CreatedFrom = _createdFrom.HasValue ? DateTime.SpecifyKind(_createdFrom.Value, DateTimeKind.Utc) : null,
            CreatedTo = createdToEnd.HasValue ? DateTime.SpecifyKind(createdToEnd.Value, DateTimeKind.Utc) : null,
            CompletedFrom = _completedFrom.HasValue ? DateTime.SpecifyKind(_completedFrom.Value, DateTimeKind.Utc) : null,
            CompletedTo = completedToEnd.HasValue ? DateTime.SpecifyKind(completedToEnd.Value, DateTimeKind.Utc) : null
        };
    }

    private async Task LoadSessions()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var filter = BuildFilter();
            var result = await ApiClient.GetSessionsPagedAsync(_pageSize, _endCursor, filter);
            _sessions = result.Items;
            _totalCount = result.TotalCount;
            _hasNextPage = result.HasNextPage;
            _hasPreviousPage = _cursorStack.Count > 0;
            _endCursor = result.EndCursor;
        }
        catch (Exception ex)
        {
            _error = string.Format(LSessions["LoadError"], ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task OnSearchInput()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                _searchDebounceTimer?.Dispose();
                _searchDebounceTimer = null;
                ResetPagination();
                await LoadSessions();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task OnRefreshClick()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task OnPageSizeChanged()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task GoToNextPage()
    {
        if (_endCursor != null)
            _cursorStack.Add(_endCursor);
        await LoadSessions();
    }

    private async Task GoToPreviousPage()
    {
        if (_cursorStack.Count > 0)
            _cursorStack.RemoveAt(_cursorStack.Count - 1);
        _endCursor = _cursorStack.Count > 0 ? _cursorStack[^1] : null;
        await LoadSessions();
    }

    private void ResetPagination()
    {
        _endCursor = null;
        _cursorStack.Clear();
    }

    private void OpenReplay(Guid sessionId)
    {
        Navigation.NavigateTo($"/settings/sessions/{sessionId}");
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
    }

    private static string TruncateClientId(string clientId)
    {
        if (string.IsNullOrEmpty(clientId)) return "—";
        return clientId.Length > 16 ? clientId[..16] + "..." : clientId;
    }

    private static string FormatChannel(string? channel)
    {
        return channel?.ToUpperInvariant() switch
        {
            "TELEGRAM" => "Telegram",
            "WEB" => "Web",
            "WHATSAPP" => "WhatsApp",
            "API" => "API",
            "EMAIL" => "Email",
            _ => channel ?? "—"
        };
    }

    private static string StatusBadgeClass(string? status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => "settings-badge-primary",
        "COMPLETED" => "settings-badge-success",
        "FAILED" => "settings-badge-danger",
        "CANCELLED" => "settings-badge-warning",
        _ => "settings-badge-neutral"
    };

    private string StatusLabel(string? status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => LSessions["StatusActiveSingular"],
        "COMPLETED" => LSessions["StatusCompletedSingular"],
        "FAILED" => LSessions["StatusFailedSingular"],
        "CANCELLED" => LSessions["StatusCancelledSingular"],
        _ => status ?? "—"
    };
}
