@page "/settings/analytics"
@page "/analytics"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IStringLocalizer<Analytics> LAnalytics

<PageTitle>@LAnalytics["PageTitle"] — ChatFoundry</PageTitle>

<div class="coming-soon">
    <div class="coming-soon-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
    </div>
    <h1 class="coming-soon-title">@LAnalytics["Title"]</h1>
    <p class="coming-soon-desc">
        @LAnalytics["Desc"]
    </p>

    <div class="an-metrics-grid">
        <div class="an-metric-card">
            <div class="an-metric-icon" style="background: #eef2ff;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            </div>
            <div class="an-metric-value">—</div>
            <div class="an-metric-label">@LAnalytics["MetricMessages"]</div>
        </div>
        <div class="an-metric-card">
            <div class="an-metric-icon" style="background: #ecfdf5;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="an-metric-value">—</div>
            <div class="an-metric-label">@LAnalytics["MetricActiveBots"]</div>
        </div>
        <div class="an-metric-card">
            <div class="an-metric-icon" style="background: #faf5ff;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="an-metric-value">—</div>
            <div class="an-metric-label">@LAnalytics["MetricUniqueUsers"]</div>
        </div>
        <div class="an-metric-card">
            <div class="an-metric-icon" style="background: #fff7ed;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div class="an-metric-value">—</div>
            <div class="an-metric-label">@LAnalytics["MetricAvgResponseTime"]</div>
        </div>
    </div>
</div>
