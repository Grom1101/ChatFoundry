@page "/forgot-password"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<ForgotPassword> LForgot

<PageTitle>@LForgot["PageTitle"] — ChatFoundry</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <svg width="40" height="40" viewBox="0 0 28 28" fill="none">
                <rect width="28" height="28" rx="7" fill="url(#forgot-grad)"/>
                <path d="M8 10.5C8 9.67 8.67 9 9.5 9H18.5C19.33 9 20 9.67 20 10.5V16.5C20 17.33 19.33 18 18.5 18H13L10 21V18H9.5C8.67 18 8 17.33 8 16.5V10.5Z" fill="white" opacity="0.95"/>
                <circle cx="12" cy="13.5" r="1" fill="url(#forgot-grad)"/>
                <circle cx="16" cy="13.5" r="1" fill="url(#forgot-grad)"/>
                <defs>
                    <linearGradient id="forgot-grad" x1="0" y1="0" x2="28" y2="28">
                        <stop offset="0%" stop-color="#6366f1"/>
                        <stop offset="100%" stop-color="#8b5cf6"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <h1 class="login-title">@LForgot["Title"]</h1>
        <p class="login-subtitle">@LForgot["Subtitle"]</p>

        @if (success)
        {
            <div class="login-error" style="background: #ecfdf5; border-color: #10b981; color: #065f46;">
                <span>@LForgot["SuccessMessage"]</span>
            </div>
            <div class="login-footer">
                <span>@LForgot["RememberedPassword"]</span>
                <a href="/login">@LForgot["SignIn"]</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="login-error">
                    <span>@error</span>
                </div>
            }

            <div class="login-form">
                <div class="login-field">
                    <label class="login-label" for="email">@LForgot["LabelEmail"]</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="M22 7l-10 6L2 7"/>
                        </svg>
                        <input id="email"
                               type="email"
                               class="login-input"
                               placeholder="you@example.com"
                               @bind="email"
                               @onkeydown="OnKeyDown" />
                    </div>
                </div>

                <button class="login-btn" @onclick="HandleSubmit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="login-spinner"></span>
                    }
                    else
                    {
                        <span>@LForgot["BtnSendLink"]</span>
                    }
                </button>
            </div>

            <div class="login-footer">
                <span>@LForgot["RememberedPassword"]</span>
                <a href="/login">@LForgot["SignIn"]</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailFromQuery { get; set; }

    private string email = "";
    private string? error;
    private bool isLoading;
    private bool success;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(EmailFromQuery))
            email = EmailFromQuery.Trim();
    }

    private async Task HandleSubmit()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(email))
        {
            error = LForgot["ErrorEmptyEmail"];
            return;
        }
        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"{ApiEndpoints.Api}/identity/auth/forgot-password", new { email = email.Trim() });
            if (response.IsSuccessStatusCode)
                success = true;
            else
                error = LForgot["ErrorSendFailed"];
        }
        catch
        {
            error = LForgot["ErrorConnection"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleSubmit();
    }
}
