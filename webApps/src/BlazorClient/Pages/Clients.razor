@page "/clients"
@using Microsoft.AspNetCore.Authorization
@using BlazorClient.Components
@attribute [Authorize]
@inject IClientApiClient ClientApi
@inject NavigationManager Navigation
@inject IStringLocalizer<Clients> LClients

<PageTitle>@LClients["PageTitle"]</PageTitle>

<div class="clients-page">
    <!-- Header -->
    <div class="clients-header">
        <div class="clients-header-left">
            <h1 class="clients-title">@LClients["PageTitle"]</h1>
            @if (!isLoading && totalCount > 0)
            {
                <span class="clients-count">@totalCount</span>
            }
        </div>
        <button class="clients-btn clients-btn-primary" @onclick="OpenCreateDialog">
            <svg class="me-2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            @LClients["BtnAddClient"]
        </button>
    </div>

    <!-- Toolbar: Search + Filter -->
    <div class="clients-toolbar">
        <div class="clients-search-wrap">
            <svg class="clients-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text"
                   class="clients-search"
                   placeholder="@LClients["SearchPlaceholder"]"
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="clients-search-clear" @onclick="ClearSearch">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                    </svg>
                </button>
            }
        </div>

        <div class="clients-filter-wrap">
            <select class="clients-filter" @bind="selectedChannel" @bind:after="OnFilterChanged">
                <option value="">@LClients["FilterAllChannels"]</option>
                <option value="TELEGRAM">Telegram</option>
                <option value="WEB">Web</option>
                <option value="WHATSAPP">WhatsApp</option>
                <option value="API">API</option>
                <option value="EMAIL">Email</option>
            </select>
        </div>
    </div>

    <!-- Content -->
    @if (isLoading)
    {
        <div class="clients-loading">
            <div class="clients-spinner"></div>
            <p>@LClients["Loading"]</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="clients-error">
            <p>@error</p>
            <button class="clients-btn clients-btn-primary" @onclick="LoadClients">@LClients["Retry"]</button>
        </div>
    }
    else if (clients.Count == 0)
    {
        <div class="clients-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <p class="clients-empty-title">@LClients["EmptyTitle"]</p>
            <p class="clients-empty-desc">
                @if (!string.IsNullOrEmpty(searchText) || !string.IsNullOrEmpty(selectedChannel))
                {
                    <span>@LClients["EmptyDescFiltered"]</span>
                }
                else
                {
                    <span>@LClients["EmptyDescDefault"]</span>
                }
            </p>
        </div>
    }
    else
    {
        <!-- Table -->
        <div class="clients-table-wrap">
            <table class="clients-table">
                <thead>
                    <tr>
                        <th class="clients-th clients-th-sortable" @onclick='() => ToggleSort("displayName")'>
                            @LClients["ThName"]
                            @if (sortField == "displayName")
                            {
                                <span class="clients-sort-arrow">@(sortDirection == "ASC" ? "\u2191" : "\u2193")</span>
                            }
                        </th>
                        <th class="clients-th">@LClients["ThChannels"]</th>
                        <th class="clients-th">@LClients["ThContact"]</th>
                        <th class="clients-th">@LClients["ThPhone"]</th>
                        <th class="clients-th">@LClients["ThEmail"]</th>
                        <th class="clients-th clients-th-sortable" @onclick='() => ToggleSort("createdAt")'>
                            @LClients["ThCreated"]
                            @if (sortField == "createdAt")
                            {
                                <span class="clients-sort-arrow">@(sortDirection == "ASC" ? "\u2191" : "\u2193")</span>
                            }
                        </th>
                        <th class="clients-th clients-th-sortable" @onclick='() => ToggleSort("modifiedAt")'>
                            @LClients["ThActivity"]
                            @if (sortField == "modifiedAt")
                            {
                                <span class="clients-sort-arrow">@(sortDirection == "ASC" ? "\u2191" : "\u2193")</span>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in clients)
                    {
                        <tr class="clients-row"
                            @onclick="() => NavigateToClient(client.Id)">
                            <td class="clients-td clients-td-name">
                                <div class="clients-avatar">
                                    @(GetInitials(client))
                                </div>
                                <span>@GetDisplayName(client)</span>
                            </td>
                            <td class="clients-td">
                                <div class="clients-badges">
                                    @foreach (var ch in client.ClientChannels)
                                    {
                                        <span class="clients-badge clients-badge-@(ch.Channel.ToLowerInvariant())">@ch.Channel</span>
                                    }
                                </div>
                            </td>
                            <td class="clients-td clients-td-contact">
                                @GetContactDisplay(client)
                            </td>
                            <td class="clients-td clients-td-contact">
                                @GetFirstPhone(client)
                            </td>
                            <td class="clients-td clients-td-contact">
                                @GetFirstEmail(client)
                            </td>
                            <td class="clients-td clients-td-date">
                                @client.CreatedAt.ToString("dd.MM.yyyy")
                            </td>
                            <td class="clients-td clients-td-date">
                                @client.ModifiedAt.ToString("dd.MM.yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="clients-pagination">
            <div class="clients-pagination-info">
                <span class="clients-muted">
                    @string.Format(LClients["PaginationShown"].Value, clients.Count, totalCount)
                </span>
            </div>

            <div class="clients-pagination-controls">
                <label class="clients-muted">@LClients["PaginationSize"]</label>
                <select class="clients-page-size" @bind="pageSize" @bind:after="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>

                <button class="clients-btn clients-btn-page"
                        disabled="@(!hasPreviousPage)"
                        @onclick="GoToPreviousPage">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
                <button class="clients-btn clients-btn-page"
                        disabled="@(!hasNextPage)"
                        @onclick="GoToNextPage">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <CreateClientDialog IsOpen="@_isCreateDialogOpen" OnClose="CloseCreateDialog" OnClientCreated="OnClientCreated" />
</div>

@code {
    private List<ClientDto> clients = [];
    private bool _isCreateDialogOpen;

    private void OpenCreateDialog()
    {
        _isCreateDialogOpen = true;
    }

    private void CloseCreateDialog()
    {
        _isCreateDialogOpen = false;
    }

    private async Task OnClientCreated(ClientDto newClient)
    {
        _isCreateDialogOpen = false;
        ResetPagination();
        await LoadClients();
    }
    private bool isLoading = true;
    private string? error;

    private string searchText = "";
    private string selectedChannel = "";
    private string sortField = "createdAt";
    private string sortDirection = "DESC";

    private int pageSize = 25;
    private string? endCursor;
    private bool hasNextPage;
    private bool hasPreviousPage;
    private int totalCount;

    private System.Timers.Timer? debounceTimer;
    private readonly List<string> cursorStack = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        isLoading = true;
        error = null;
        StateHasChanged();

        try
        {
            var result = await ClientApi.GetClientsAsync(
                first: pageSize,
                after: endCursor,
                search: string.IsNullOrWhiteSpace(searchText) ? null : searchText,
                channelFilter: string.IsNullOrEmpty(selectedChannel) ? null : selectedChannel,
                sortField: sortField,
                sortDirection: sortDirection);

            clients = result.Items;
            totalCount = result.TotalCount;
            hasNextPage = result.HasNextPage;
            hasPreviousPage = cursorStack.Count > 0;
            endCursor = result.EndCursor;
        }
        catch (Exception ex)
        {
            error = string.Format(LClients["LoadError"].Value, ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(400);
        debounceTimer.Elapsed += async (_, _) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                ResetPagination();
                await LoadClients();
            });
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task ClearSearch()
    {
        searchText = "";
        ResetPagination();
        await LoadClients();
    }

    private async Task OnFilterChanged()
    {
        ResetPagination();
        await LoadClients();
    }

    private async Task OnPageSizeChanged()
    {
        ResetPagination();
        await LoadClients();
    }

    private void ToggleSort(string field)
    {
        if (sortField == field)
        {
            sortDirection = sortDirection == "ASC" ? "DESC" : "ASC";
        }
        else
        {
            sortField = field;
            sortDirection = "ASC";
        }

        ResetPagination();
        _ = LoadClients();
    }

    private async Task GoToNextPage()
    {
        if (endCursor != null)
        {
            cursorStack.Add(endCursor);
        }
        await LoadClients();
    }

    private async Task GoToPreviousPage()
    {
        if (cursorStack.Count > 0)
        {
            cursorStack.RemoveAt(cursorStack.Count - 1);
        }
        endCursor = cursorStack.Count > 0 ? cursorStack[^1] : null;
        await LoadClients();
    }

    private void ResetPagination()
    {
        endCursor = null;
        cursorStack.Clear();
    }

    private void NavigateToClient(Guid clientId)
    {
        Navigation.NavigateTo($"/clients/{clientId}");
    }

    private static string GetDisplayName(ClientDto client)
    {
        var ch = client.ClientChannels.FirstOrDefault();
        if (ch != null)
        {
            var namePart = string.Join(" ", new[] { ch.Name, ch.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray()).Trim();
            if (!string.IsNullOrEmpty(namePart)) return namePart;
            if (!string.IsNullOrWhiteSpace(ch.Username)) return "@" + ch.Username;
        }
        if (!string.IsNullOrWhiteSpace(client.DisplayName)) return client.DisplayName;
        return "—";
    }

    private static string GetContactDisplay(ClientDto client)
    {
        var ch = client.ClientChannels.FirstOrDefault();
        if (ch == null) return "—";
        if (!string.IsNullOrWhiteSpace(ch.Username)) return "@" + ch.Username;
        if (!string.IsNullOrWhiteSpace(ch.Phone)) return ch.Phone;
        if (!string.IsNullOrWhiteSpace(ch.Email)) return ch.Email;
        return ch.ExternalUserId ?? "—";
    }

    private static string GetFirstPhone(ClientDto client)
    {
        var phone = client.ClientChannels.Select(ch => ch.Phone).FirstOrDefault(p => !string.IsNullOrWhiteSpace(p));
        return phone ?? "—";
    }

    private static string GetFirstEmail(ClientDto client)
    {
        var email = client.ClientChannels.Select(ch => ch.Email).FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));
        return email ?? "—";
    }

    private static string GetInitials(ClientDto client)
    {
        var ch = client.ClientChannels.FirstOrDefault();
        if (ch != null && !string.IsNullOrWhiteSpace(ch.Name))
            return ch.Name[..1].ToUpper();
        if (ch != null && !string.IsNullOrWhiteSpace(ch.Username))
            return ch.Username[..1].ToUpper();
        if (!string.IsNullOrWhiteSpace(client.DisplayName))
        {
            var parts = client.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : $"{parts[0][0]}".ToUpper();
        }
        return "?";
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
