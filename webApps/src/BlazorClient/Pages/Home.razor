@page "/"
@inject IStringLocalizer<Home> LHome

<PageTitle>@LHome["PageTitle"]</PageTitle>

<!-- Hero -->
<section class="hero">
    <div class="hero-inner">
        <div class="hero-badge">Open Source / Self-Hosted / SaaS</div>
        <h1 class="hero-title">
            @LHome["HeroTitlePart1"]<br/>
            <span class="hero-accent">@LHome["HeroTitleAccent"]</span>
        </h1>
        <p class="hero-subtitle">
            @LHome["HeroSubtitle"]
        </p>
        <div class="hero-actions">
            <a href="/bots" class="btn-hero-primary">
                @LHome["HeroStartFree"]
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="margin-left: 6px;">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
            <a href="https://github.com" target="_blank" rel="noopener" class="btn-hero-secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                GitHub
            </a>
        </div>

        <div class="hero-visual">
            <div class="hero-flow">
                <div class="flow-node flow-start">Start</div>
                <div class="flow-arrow"></div>
                <div class="flow-node flow-message">Message</div>
                <div class="flow-arrow"></div>
                <div class="flow-node flow-ai">AI Generate</div>
                <div class="flow-arrow"></div>
                <div class="flow-node flow-condition">Condition</div>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="features">
    <div class="section-inner">
        <div class="section-header">
            <h2 class="section-title">@LHome["FeaturesTitle"]</h2>
            <p class="section-subtitle">@LHome["FeaturesSubtitle"]</p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background: #eef2ff; color: #6366f1;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature1Title"]</h3>
                <p class="feature-desc">@LHome["Feature1Desc"]</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: #faf5ff; color: #8b5cf6;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a4 4 0 014 4v2a4 4 0 01-8 0V6a4 4 0 014-4z"/>
                        <path d="M9 18h6"/>
                        <path d="M12 14v4"/>
                        <circle cx="12" cy="21" r="1"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature2Title"]</h3>
                <p class="feature-desc">@LHome["Feature2Desc"]</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: #ecfdf5; color: #10b981;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature3Title"]</h3>
                <p class="feature-desc">@LHome["Feature3Desc"]</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: #fff7ed; color: #f97316;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8"/>
                        <path d="M12 17v4"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature4Title"]</h3>
                <p class="feature-desc">@LHome["Feature4Desc"]</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: #fef2f2; color: #ef4444;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature5Title"]</h3>
                <p class="feature-desc">@LHome["Feature5Desc"]</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: #f0f9ff; color: #0ea5e9;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3 class="feature-title">@LHome["Feature6Title"]</h3>
                <p class="feature-desc">@LHome["Feature6Desc"]</p>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="how-it-works">
    <div class="section-inner">
        <div class="section-header">
            <h2 class="section-title">@LHome["HowItWorksTitle"]</h2>
            <p class="section-subtitle">@LHome["HowItWorksSubtitle"]</p>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <h3 class="step-title">@LHome["Step1Title"]</h3>
                <p class="step-desc">@LHome["Step1Desc"]</p>
            </div>
            <div class="step-divider"></div>
            <div class="step">
                <div class="step-number">2</div>
                <h3 class="step-title">@LHome["Step2Title"]</h3>
                <p class="step-desc">@LHome["Step2Desc"]</p>
            </div>
            <div class="step-divider"></div>
            <div class="step">
                <div class="step-number">3</div>
                <h3 class="step-title">@LHome["Step3Title"]</h3>
                <p class="step-desc">@LHome["Step3Desc"]</p>
            </div>
        </div>
    </div>
</section>

<!-- Free Tier -->
<section class="free-tier">
    <div class="section-inner">
        <div class="free-tier-card">
            <div class="free-tier-badge">@LHome["FreeTierBadge"]</div>
            <h2 class="free-tier-title">@LHome["FreeTitle"]</h2>
            <p class="free-tier-subtitle">
                @LHome["FreeSubtitle"]
            </p>
            <ul class="free-tier-features">
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @LHome["FreeItem1"]
                </li>
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @LHome["FreeItem2"]
                </li>
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @LHome["FreeItem3"]
                </li>
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @LHome["FreeItem4"]
                </li>
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @LHome["FreeItem5"]
                </li>
            </ul>
            <a href="/bots" class="btn-free-tier">
                @LHome["FreeButton"]
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="margin-left: 8px;">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta">
    <div class="section-inner">
        <h2 class="cta-title">@LHome["CtaTitle"]</h2>
        <p class="cta-subtitle">@LHome["CtaSubtitle"]</p>
        <a href="/bots" class="btn-hero-primary">
            @LHome["HeroStartFree"]
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="margin-left: 6px;">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
    </div>
</section>
