@page "/register"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Register> LRegister

<PageTitle>@LRegister["PageTitle"] — ChatFoundry</PageTitle>

<div class="register-page">
    <div class="register-card">
        <!-- Logo -->
        <div class="register-logo">
            <svg width="40" height="40" viewBox="0 0 28 28" fill="none">
                <rect width="28" height="28" rx="7" fill="url(#reg-grad)"/>
                <path d="M8 10.5C8 9.67 8.67 9 9.5 9H18.5C19.33 9 20 9.67 20 10.5V16.5C20 17.33 19.33 18 18.5 18H13L10 21V18H9.5C8.67 18 8 17.33 8 16.5V10.5Z" fill="white" opacity="0.95"/>
                <circle cx="12" cy="13.5" r="1" fill="url(#reg-grad)"/>
                <circle cx="16" cy="13.5" r="1" fill="url(#reg-grad)"/>
                <defs>
                    <linearGradient id="reg-grad" x1="0" y1="0" x2="28" y2="28">
                        <stop offset="0%" stop-color="#6366f1"/>
                        <stop offset="100%" stop-color="#8b5cf6"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <h1 class="register-title">@LRegister["Title"]</h1>
        <p class="register-subtitle">@LRegister["Subtitle"]</p>

        <!-- Success -->
        @if (registrationSuccess)
        {
            <div class="register-error" style="background: #ecfdf5; border-color: #10b981; color: #065f46;">
                <span>@LRegister["SuccessMessage"]</span>
            </div>
            <div class="register-footer" style="margin-top: 1rem;">
                <a href="/login">@LRegister["SignIn"]</a>
            </div>
        }

        <!-- Error -->
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="register-error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <span>@error</span>
            </div>
        }

        <!-- Form -->
        @if (!registrationSuccess)
        {
        <div class="register-form">
            <div class="register-field">
                <label class="register-label" for="reg-email">@LRegister["LabelEmail"]</label>
                <div class="register-input-wrap">
                    <svg class="register-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="M22 7l-10 6L2 7"/>
                    </svg>
                    <input id="reg-email"
                           type="email"
                           class="register-input"
                           placeholder="you@example.com"
                           @bind="email"
                           @onkeydown="OnKeyDown" />
                </div>
            </div>

            <div class="register-field">
                <label class="register-label" for="reg-password">@LRegister["LabelPassword"]</label>
                <div class="register-input-wrap">
                    <svg class="register-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                    <input id="reg-password"
                           type="password"
                           class="register-input"
                           placeholder="@LRegister["PlaceholderPassword"]"
                           @bind="password"
                           @onkeydown="OnKeyDown" />
                </div>
            </div>

            <div class="register-field">
                <label class="register-label" for="reg-confirm">@LRegister["LabelConfirmPassword"]</label>
                <div class="register-input-wrap">
                    <svg class="register-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <input id="reg-confirm"
                           type="password"
                           class="register-input"
                           placeholder="@LRegister["PlaceholderConfirmPassword"]"
                           @bind="confirmPassword"
                           @onkeydown="OnKeyDown" />
                </div>
            </div>

            @if (!hasInvite)
            {
                <div class="register-field">
                    <label class="register-label" for="reg-company">@LRegister["LabelCompany"]</label>
                    <div class="register-input-wrap">
                        <input id="reg-company"
                               type="text"
                               class="register-input"
                               placeholder="@LRegister["PlaceholderCompany"]"
                               @bind="companyName"
                               @onkeydown="OnKeyDown" />
                    </div>
                </div>
            }

            <button class="register-btn" @onclick="HandleRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="register-spinner"></span>
                }
                else
                {
                    <span>@LRegister["BtnCreateAccount"]</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="margin-left: 6px;">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                }
            </button>
        </div>
        }

        @if (!registrationSuccess)
        {
        <div class="register-footer">
            <span>@LRegister["AlreadyHaveAccount"]</span>
            <a href="/login">@LRegister["SignIn"]</a>
        </div>
        }
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string companyName = "";
    private string? error;
    private bool isLoading;
    private bool hasInvite;
    private bool registrationSuccess;

    protected override void OnInitialized()
    {
        hasInvite = !string.IsNullOrWhiteSpace(GetInviteToken());
    }

    private string? GetInviteToken()
    {
        var u = Navigation.Uri;
        var i = u.IndexOf("invite=", StringComparison.OrdinalIgnoreCase);
        if (i < 0) return null;
        i += 7;
        var end = u.IndexOf('&', i);
        return end < 0 ? u[i..] : u[i..end];
    }

    private async Task HandleRegister()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = LRegister["ErrorEmptyEmail"];
            return;
        }

        if (password.Length < 2)
        {
            error = LRegister["ErrorShortPassword"];
            return;
        }

        if (password != confirmPassword)
        {
            error = LRegister["ErrorPasswordMismatch"];
            return;
        }

        if (!hasInvite && string.IsNullOrWhiteSpace(companyName))
        {
            error = LRegister["ErrorEmptyCompany"];
            return;
        }

        isLoading = true;

        try
        {
        var inviteToken = GetInviteToken();

        var payload = hasInvite && !string.IsNullOrWhiteSpace(inviteToken)
            ? (object)new { Email = email, Password = password, InviteToken = inviteToken }
            : new { Email = email, Password = password, CompanyName = companyName.Trim() };

            var registerResponse = await Http.PostAsJsonAsync($"{ApiEndpoints.Api}/identity/auth/register", payload);

            if (!registerResponse.IsSuccessStatusCode)
            {
                var body = await registerResponse.Content.ReadAsStringAsync();
                error = body.Contains("DuplicateUserName")
                    ? LRegister["ErrorDuplicateUser"]
                    : LRegister["ErrorDefault"];
                return;
            }

            registrationSuccess = true;
        }
        catch (Exception ex)
        {
            error = LRegister["ErrorConnection"];
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleRegister();
        }
    }
}
