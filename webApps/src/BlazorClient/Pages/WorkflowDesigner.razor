                    }
                    else if (link.Condition?.IsEmpty != null)
                    {
                        <div class="card p-3 border-secondary mb-3 shadow-sm">
                            <div class="designer-var-row mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>@LDesigner["VariableLabel"]</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary designer-var-picker-btn" title="@LDesigner["InsertVariableTooltip"]" @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition!.IsEmpty!, nameof(UnaryConditionBase.Left), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
