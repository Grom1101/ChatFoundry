@page "/designer/{WorkflowId:guid}"
@using Blazor.Diagrams.Components
@attribute [Authorize]
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Models
@using BlazorClient.Models.Diagram
@using Microsoft.AspNetCore.Authorization
@using BlazorClient.Components
@layout DesignerLayout

<PageTitle>@LDesigner["PageTitleWorkflowEditor"]</PageTitle>

<div class="designer-page-container">
    <!-- Левая панель с узлами (референс code.html) -->
    <aside class="designer-sidebar">
        <div class="sidebar-brand">
            <a href="/" class="sidebar-brand-logo" title="ChatFoundry">
                <span class="sidebar-brand-icon sidebar-brand-icon--svg">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                        <rect width="28" height="28" rx="7" fill="url(#sidebar-logo-grad)" />
                        <path d="M8 10.5C8 9.67 8.67 9 9.5 9H18.5C19.33 9 20 9.67 20 10.5V16.5C20 17.33 19.33 18 18.5 18H13L10 21V18H9.5C8.67 18 8 17.33 8 16.5V10.5Z" fill="white" opacity="0.95"/>
                        <circle cx="12" cy="13.5" r="1" fill="url(#sidebar-logo-grad)"/>
                        <circle cx="16" cy="13.5" r="1" fill="url(#sidebar-logo-grad)"/>
                        <defs>
                            <linearGradient id="sidebar-logo-grad" x1="0" y1="0" x2="28" y2="28">
                                <stop offset="0%" stop-color="#6366f1"/>
                                <stop offset="100%" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
            </a>
            <span class="sidebar-brand-text">ChatFoundry</span>
        </div>
        <div class="sidebar-search">
            <span class="sidebar-search-icon oi oi-magnifying-glass"></span>
            <input type="text" class="sidebar-search-input" placeholder="@LDesigner["SearchNodesPlaceholder"]" 
                   @bind="NodeSearchQuery" @bind:event="oninput" />
        </div>
        <div class="sidebar-content">
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">@LDesigner["SectionLogic"]</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == LDesigner["SectionLogic"].Value))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass">@((MarkupString)item.IconSvg)</span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">@LDesigner["SectionContent"]</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == LDesigner["SectionContent"].Value))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass">@((MarkupString)item.IconSvg)</span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">@LDesigner["SectionAiIntegrations"]</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == LDesigner["SectionAiIntegrations"].Value))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass">@((MarkupString)item.IconSvg)</span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- Основная область: топ-бар + канвас -->
    <main class="designer-main">
        <header class="designer-header">
            <div class="designer-header-left">
                <span class="designer-workflow-title">@LDesigner["PageTitleWorkflowEditor"]</span>
                <span class="designer-badge">Editor</span>
                <span class="designer-header-divider"></span>
                <span class="designer-last-saved">@LastSavedText</span>
            </div>
            <div class="designer-header-right">
                <div class="designer-undo-redo">
                    <button type="button" class="designer-undo-btn" @onclick="Undo" disabled="@(_undoIndex <= 0)" title="@LDesigner["BackLabel"]">
                        <span class="oi oi-arrow-left"></span>
                    </button>
                    <button type="button" class="designer-redo-btn" @onclick="Redo" disabled="@(_undoIndex >= _undoStack.Count - 1)" title="@LDesigner["RedoBtnTooltip"]">
                        <span class="oi oi-arrow-right"></span>
                    </button>
                </div>
                <button type="button" class="designer-btn-secondary" @onclick="OpenVariablesModal" title="@LDesigner["AttributesParamsBtnTooltip"]">
                    <span class="oi oi-code"></span> @LDesigner["AttributesParamsBtn"]
                </button>
                <div class="designer-json-dropdown">
                    <button type="button" class="designer-btn-secondary" @onclick="() => _jsonMenuOpen = !_jsonMenuOpen" title="@LDesigner["SchemaBtnTooltip"]">
                        <span class="oi oi-document"></span> @LDesigner["SchemaBtn"] <span class="oi oi-chevron-bottom"></span>
                    </button>
                    @if (_jsonMenuOpen)
                    {
                        <div class="designer-json-dropdown-backdrop" @onclick="() => _jsonMenuOpen = false"></div>
                        <ul class="dropdown-menu dropdown-menu-end show">
                            <li><button type="button" class="dropdown-item" @onclick="CloseJsonMenuAndDownload"><span class="oi oi-data-transfer-download"></span> @LDesigner["DownloadBtn"]</button></li>
                            <li><button type="button" class="dropdown-item" @onclick="TriggerImportJsonFile"><span class="oi oi-data-transfer-upload"></span> @LDesigner["UploadBtn"]</button></li>
                        </ul>
                    }
                </div>
                <div id="workflow-json-file-wrap" class="d-none">
                    <InputFile accept=".json,application/json" OnChange="OnImportWorkflowJson" />
                </div>
                <button type="button" class="designer-btn-secondary" @onclick="OpenAiModal" title="@LDesigner["GenerateAiBtnTooltip"]">
                    <span class="oi oi-lightbulb"></span> AI
                </button>
                <button type="button" class="designer-btn-primary designer-header-save" @onclick="SaveWorkflow" title="@LDesigner["SaveBtnTooltip"]">
                    <span class="oi oi-circle-check"></span> @LDesigner["SaveBtn"]
                </button>
            </div>
        </header>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <div class="alert alert-danger m-3" role="alert">
                @_loadError
            </div>
        }
        <div id="designer-canvas-area" class="canvas-area" 
             @ondrop="OnDrop" 
             @ondragover="OnDragOver" 
             @ondragover:preventDefault="true">
            <CascadingValue Value="Diagram">
                <CascadingValue Name="WorkflowNodePreviewFormatter" Value="@FormatPreviewForNodeWidget" IsFixed="true">
                <DiagramCanvas class="designer-canvas">
                    <Widgets>
                        <GridWidget Size="24" Mode="GridMode.Point" BackgroundColor="#ffffff"/>
                        <SelectionBoxWidget/>
                    </Widgets>
                </DiagramCanvas>
                </CascadingValue>
            </CascadingValue>

            <!-- Зум: слева снизу -->
            <div class="designer-zoom-controls">
                <button type="button" class="designer-zoom-btn" @onclick="ZoomOut" title="@LDesigner["ZoomOutTooltip"]">
                    <span class="oi oi-minus"></span>
                </button>
                <span class="designer-zoom-value">@(ZoomPercent)%</span>
                <button type="button" class="designer-zoom-btn" @onclick="ZoomIn" title="@LDesigner["ZoomInTooltip"]">
                    <span class="oi oi-plus"></span>
                </button>
            </div>
        </div>

        <!-- Панель настроек узла (справа, референс code.html) -->
        @if (SelectedModel != null)
        {
            <div class="designer-settings-panel" @onpointerenter="OnSettingsPanelPointerEnter">
            <div class="panel-header">
                <h6>@LDesigner["SettingsTitle"]</h6>
                <button type="button" class="btn-close" @onclick="() => SelectedModel = null"></button>
            </div>
            <div class="panel-body">
                @if (SelectedModel is NodeModel node)
                {
                    <div class="mb-3">
                        <label class="form-label">@LDesigner["LabelTitle"]</label>
                        <input type="text" class="form-control" @bind-value="node.Title" @bind-value:event="oninput"/>
                    </div>

                    @if (node is WorkflowNodeModel { Data: MessageNodeData msgData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["LabelMsgText"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(msgData, nameof(msgData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace variable-input" 
                                      value="@ToDisplayText(msgData.Text)"
                                      @oninput="e => { UpdateFieldAndCheckAtMention(e, msgData, nameof(msgData.Text)); OnWorkflowChanged(); }"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                @((MarkupString)string.Format(LDesigner["EnterAtToSelectVarOrManual"].Value, "<kbd>@@</kbd>", "<code>{{variable_name}}</code>"))
                            </small>
                        </div>
                        <div class="mb-3 border-top pt-3 mt-3">
                            <label class="form-label d-block fw-bold">@LDesigner["LabelRecipientTitle"]</label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientSession_@node.Id" 
                                       checked="@(!msgData.SendToCustomRecipient)" 
                                       @onclick="() => SetRecipientToSession(msgData)" />
                                <label class="form-check-label" for="recipientSession_@node.Id">
                                    @LDesigner["RecipientCurrentSession"]
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientCustom_@node.Id" 
                                       checked="@msgData.SendToCustomRecipient" 
                                       @onclick="() => OpenClientPicker(msgData)" />
                                <label class="form-check-label" for="recipientCustom_@node.Id">
                                    @LDesigner["RecipientCustomClient"]
                                </label>
                            </div>
                            @if (msgData.SendToCustomRecipient)
                            {
                                <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center mt-2">
                                    <span class="small">
                                        @if (msgData.CustomRecipientClientChannelId.HasValue && _recipientDetailsCache.TryGetValue(msgData.CustomRecipientClientChannelId.Value, out var details))
                                        {
                                            <strong>@details.ClientDisplayName</strong> <span class="text-muted">(@details.Channel.Channel: @(details.Channel.Username ?? details.Channel.Phone ?? details.Channel.Email ?? details.Channel.ExternalUserId))</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@LDesigner["RecipientNotSelected"]</span>
                                        }
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenClientPicker(msgData)">
                                        @LDesigner["BtnSelect"]
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AskNodeData askData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["LabelQuestionText"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(askData, nameof(askData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace variable-input" 
                                      value="@ToDisplayText(askData.Text)"
                                      @oninput="e => { UpdateFieldAndCheckAtMention(e, askData, nameof(askData.Text)); OnWorkflowChanged(); }"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                @((MarkupString)string.Format(LDesigner["EnterAtToSelectVarOrManual"].Value, "<kbd>@@</kbd>", "<code>{{variable_name}}</code>"))
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["LabelButtonsUnderMsg"]</label>
                            @if (askData.Ui?.Buttons != null)
                            {
                                @foreach (var btn in askData.Ui.Buttons.ToList())
                                {
                                    <div class="designer-ask-button-row">
                                        <input type="text"
                                               class="form-control designer-ask-button-input"
                                               placeholder="@LDesigner["PlaceholderBtnText"]"
                                               value="@ToDisplayText(btn.Text)"
                                               @oninput="e => { btn.Text = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"/>
                                        <button type="button" class="designer-ask-remove" title="@LDesigner["DeleteBtnTooltip"]" @onclick="() => RemoveAskButton(askData, btn)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                }
                            }
                            <button type="button" class="designer-ask-add" @onclick="() => AddAskButton(askData)">
                                <span class="oi oi-plus"></span> @LDesigner["AddBtn"]
                            </button>
                            <small class="form-text text-muted d-block mt-1">
                                @LDesigner["ButtonsHint"]
                            </small>
                        </div>
                        <div class="mb-3 border-top pt-3 mt-3">
                            <label class="form-label d-block fw-bold">@LDesigner["LabelRecipientTitle"]</label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientSession_@node.Id" 
                                       checked="@(!askData.SendToCustomRecipient)" 
                                       @onclick="() => SetRecipientToSession(askData)" />
                                <label class="form-check-label" for="recipientSession_@node.Id">
                                    @LDesigner["RecipientCurrentSession"]
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientCustom_@node.Id" 
                                       checked="@askData.SendToCustomRecipient" 
                                       @onclick="() => OpenClientPicker(askData)" />
                                <label class="form-check-label" for="recipientCustom_@node.Id">
                                    @LDesigner["RecipientCustomClient"]
                                </label>
                            </div>
                            @if (askData.SendToCustomRecipient)
                            {
                                <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center mt-2">
                                    <span class="small">
                                        @if (askData.CustomRecipientClientChannelId.HasValue && _recipientDetailsCache.TryGetValue(askData.CustomRecipientClientChannelId.Value, out var details))
                                        {
                                            <strong>@details.ClientDisplayName</strong> <span class="text-muted">(@details.Channel.Channel: @(details.Channel.Username ?? details.Channel.Phone ?? details.Channel.Email ?? details.Channel.ExternalUserId))</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@LDesigner["RecipientNotSelected"]</span>
                                        }
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenClientPicker(askData)">
                                        @LDesigner["BtnSelect"]
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: SetAttributeNodeData attrData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["LabelAttributeKey"]</label>
                            <select class="form-select font-monospace" 
                                    value="@NormalizeAttributeKey(attrData.Attribute)"
                                    @onchange="@(e => OnAttributeKeyChanged(attrData, e))">
                                <option value="">— @LDesigner["SelectAttributeOption"] —</option>
                                @foreach (var key in GetAttributeKeysForDropdown())
                                {
                                    <option value="@key">@GetAttributeDropdownLabel(key)</option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                @LDesigner["AttributesListHint"]
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["LabelValue"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(attrData, nameof(attrData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" 
                                   class="form-control font-monospace" 
                                   value="@ToDisplayText(attrData.Value)"
                                   @oninput="e => { attrData.Value = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="@LDesigner["PlaceholderTextOrVar"]"/>
                            <small class="form-text text-muted">
                                @LDesigner["VariablesInTemplateHint"]
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: HttpRequestNodeData httpData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["LabelMethod"]</label>
                            <select class="form-select" @bind="httpData.Method">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>URL</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Url), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text"
                                   class="form-control font-monospace"
                                   value="@ToDisplayText(httpData.Url)"
                                   @oninput="e => { httpData.Url = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="https://api.example.com/data"/>
                        </div>

                        @if (httpData.Method == "POST" || httpData.Method == "PUT")
                        {
                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between align-items-center">
                                    <span>@LDesigner["LabelRequestBody"]</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Body), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <textarea class="form-control font-monospace"
                                          rows="5"
                                          value="@ToDisplayText(httpData.Body)"
                                          @oninput="e => { httpData.Body = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                          placeholder='{"key": "{{variable_name}}"}'></textarea>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">@LDesigner["LabelHeaders"]</label>
                            <div class="designer-header-list">
                                @foreach (var header in httpData.Headers.ToList())
                                {
                                    var isExpanded = _expandedHeaderKey == header.Key;
                                    <div class="designer-header-item @(isExpanded ? "designer-header-item--open" : "")">
                                        <div class="designer-header-item-row">
                                            <button type="button" class="designer-header-toggle" title="@LDesigner["LabelValue"]"
                                                    @onclick="() => { _expandedHeaderKey = isExpanded ? null : header.Key; }">
                                                <span class="oi oi-chevron-bottom"></span>
                                            </button>
                                            <input type="text"
                                                   class="designer-header-name-input"
                                                   placeholder="Content-Type"
                                                   value="@header.Key"
                                                   @onchange="@(e => { var newKey = e.Value?.ToString() ?? ""; if (!string.IsNullOrWhiteSpace(newKey) && newKey != header.Key) { var val = httpData.Headers[header.Key]; httpData.Headers.Remove(header.Key); httpData.Headers[newKey] = val; if (_expandedHeaderKey == header.Key) _expandedHeaderKey = newKey; OnWorkflowChanged(); } })"/>
                                            <button type="button" class="designer-header-remove" title="@LDesigner["DeleteHeaderTooltip"]"
                                                    @onclick="() => { if (_expandedHeaderKey == header.Key) _expandedHeaderKey = null; RemoveHeader(httpData, header.Key); }">
                                                <span class="oi oi-x"></span>
                                            </button>
                                        </div>
                                        @if (isExpanded)
                                        {
                                            <div class="designer-header-value-area">
                                                <div class="designer-header-value-wrap">
                                                    <input type="text"
                                                           class="form-control font-monospace designer-header-value-input"
                                                           placeholder="application/json"
                                                           value="@ToDisplayText(httpData.Headers[header.Key])"
                                                           @oninput="e => { httpData.Headers[header.Key] = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }" />
                                                    <button type="button" class="designer-header-var-btn"
                                                            title="@LDesigner["InsertVariableTooltip"]"
                                                            @onclick="() => ShowVariablePicker(v => InsertVariableIntoMapping(httpData.Headers, header.Key, v))">
                                                        <span class="oi oi-code"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <button type="button" class="designer-header-add" @onclick="() => AddHeader(httpData)">
                                <span class="oi oi-plus"></span> @LDesigner["AddHeaderBtn"]
                            </button>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="http-continue-on-error-@node.Id"
                                       checked="@httpData.ContinueOnError"
                                       @onchange="e => { httpData.ContinueOnError = GetCheckboxChecked(e); OnWorkflowChanged(); }"/>
                                <label class="form-check-label" for="http-continue-on-error-@node.Id">@LDesigner["ContinueOnErrorLabel"]</label>
                            </div>
                            <small class="form-text text-muted">@LDesigner["ContinueOnErrorHintHttp"]</small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AIGenerateNodeData aiData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["AiPromptLabel"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(aiData, nameof(aiData.Prompt), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" 
                                      value="@ToDisplayText(aiData.Prompt)"
                                      @oninput="e => { aiData.Prompt = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                      rows="6"></textarea>
                            <small class="form-text text-muted">
                                @((MarkupString)string.Format(LDesigner["AiPromptHint"].Value, "<code>{{variable_name}}</code>"))
                            </small>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="ai-include-context-@node.Id"
                                       checked="@aiData.IncludeChatContext"
                                       @onchange="e => { aiData.IncludeChatContext = GetCheckboxChecked(e); OnWorkflowChanged(); }"/>
                                <label class="form-check-label" for="ai-include-context-@node.Id">@LDesigner["AiIncludeContextLabel"]</label>
                            </div>
                            <small class="form-text text-muted">@LDesigner["AiIncludeContextHint"]</small>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="ai-continue-on-error-@node.Id"
                                       checked="@aiData.ContinueOnError"
                                       @onchange="e => { aiData.ContinueOnError = GetCheckboxChecked(e); OnWorkflowChanged(); }"/>
                                <label class="form-check-label" for="ai-continue-on-error-@node.Id">@LDesigner["ContinueOnErrorLabel"]</label>
                            </div>
                            <small class="form-text text-muted">@LDesigner["ContinueOnErrorHintAi"]</small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: MediaNodeData mediaData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["UploadFileLabel"]</label>
                            <InputFile class="form-control" OnChange="@(e => OnMediaFileSelected(e, mediaData))"/>
                            <small class="form-text text-muted">@LDesigner["UploadFileHint"]</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                @LDesigner["OrChooseFromStoragePrefix"] <a href="#" class="storage-picker-link" @onclick="() => OpenStoragePicker(mediaData)" @onclick:preventDefault>@LDesigner["StorageLinkText"]</a>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["CurrentKeyFileId"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariableReplacing(mediaData, nameof(mediaData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" class="form-control font-monospace"
                                   value="@ToDisplayText(mediaData.Value)"
                                   @oninput="e => { mediaData.Value = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="@LDesigner["PlaceholderFileIdOrVar"]"/>
                            <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["VariablesSupportedHint"].Value, "<code>{{variable_name}}</code>"))</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@LDesigner["CaptionLabel"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(mediaData, nameof(mediaData.Caption), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" rows="2"
                                      value="@ToDisplayText(mediaData.Caption)"
                                      @oninput="e => { mediaData.Caption = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                      placeholder="@LDesigner["PlaceholderOptional"]"></textarea>
                            <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["VariablesSupportedHint"].Value, "<code>{{variable_name}}</code>"))</small>
                        </div>
                        <div class="mb-3 border-top pt-3 mt-3">
                            <label class="form-label d-block fw-bold">@LDesigner["LabelRecipientTitle"]</label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientSession_@node.Id" 
                                       checked="@(!mediaData.SendToCustomRecipient)" 
                                       @onclick="() => SetRecipientToSession(mediaData)" />
                                <label class="form-check-label" for="recipientSession_@node.Id">
                                    @LDesigner["RecipientCurrentSession"]
                                </label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="recipientType_@node.Id" id="recipientCustom_@node.Id" 
                                       checked="@mediaData.SendToCustomRecipient" 
                                       @onclick="() => OpenClientPicker(mediaData)" />
                                <label class="form-check-label" for="recipientCustom_@node.Id">
                                    @LDesigner["RecipientCustomClient"]
                                </label>
                            </div>
                            @if (mediaData.SendToCustomRecipient)
                            {
                                <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center mt-2">
                                    <span class="small">
                                        @if (mediaData.CustomRecipientClientChannelId.HasValue && _recipientDetailsCache.TryGetValue(mediaData.CustomRecipientClientChannelId.Value, out var details))
                                        {
                                            <strong>@details.ClientDisplayName</strong> <span class="text-muted">(@details.Channel.Channel: @(details.Channel.Username ?? details.Channel.Phone ?? details.Channel.Email ?? details.Channel.ExternalUserId))</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@LDesigner["RecipientNotSelected"]</span>
                                        }
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenClientPicker(mediaData)">
                                        @LDesigner["BtnSelect"]
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: SubWorkflowNodeData subData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["CalledProcessLabel"]</label>
                            @if (subData.WorkflowId != Guid.Empty && (AvailableWorkflows?.FirstOrDefault(w => w.Id == subData.WorkflowId)) is { } selectedW)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="text-muted">@GetWorkflowDisplayName(selectedW)</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenProcessPicker(subData)">
                                        <span class="oi oi-pencil"></span> @LDesigner["ChangeBtn"]
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (subData.WorkflowId != Guid.Empty)
                                    {
                                        <span class="text-muted">@LDesigner["ProcessSelectedLabel"]</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenProcessPicker(subData)">
                                        <span class="oi @(subData.WorkflowId != Guid.Empty ? "oi-pencil" : "oi-plus")"></span> @(subData.WorkflowId != Guid.Empty ? LDesigner["ChangeBtn"] : LDesigner["ProcessPickerTitle"])
                                    </button>
                                </div>
                            }
                        </div>

                        @if (subData.WorkflowId != Guid.Empty)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@LDesigner["InputParams"]</label>
                                <small class="form-text text-muted d-block mb-2">
                                    @((MarkupString)string.Format(LDesigner["SubProcessInputParamsHint"].Value, "<code>{{variable}}</code>"))
                                </small>
                                @foreach (var mapping in subData.InputMappings.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <span class="input-group-text font-monospace" style="min-width:120px;">@mapping.Key</span>
                                        <input type="text" class="form-control font-monospace"
                                               value="@ToDisplayText(mapping.Value)"
                                               placeholder="@LDesigner["PlaceholderVarOrValue"]"
                                               @oninput="e => { subData.InputMappings[mapping.Key] = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ShowVariablePicker(v => InsertVariableIntoMapping(subData.InputMappings, mapping.Key, v))">
                                            <span class="oi oi-code"></span>
                                        </button>
                                    </div>
                                }
                                @if (!subData.InputMappings.Any())
                                {
                                    <p class="small text-muted">@LDesigner["SubProcessNoInputParamsHint"]</p>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">@LDesigner["OutputParams"]</label>
                                <small class="form-text text-muted d-block mb-2">
                                    @LDesigner["SubProcessOutputParamsHint"]
                                </small>
                                @foreach (var mapping in subData.OutputMappings.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control font-monospace" style="max-width:40%;"
                                               value="@mapping.Key"
                                               placeholder="@LDesigner["PlaceholderVariableOnly"]"
                                               @oninput="e => { var newKey = e.Value?.ToString() ?? string.Empty; if (!string.IsNullOrWhiteSpace(newKey) && newKey != mapping.Key) { var val = subData.OutputMappings[mapping.Key]; subData.OutputMappings.Remove(mapping.Key); subData.OutputMappings[newKey] = val; OnWorkflowChanged(); } }" />
                                        <span class="input-group-text">&#8592;</span>
                                        <input type="text" class="form-control font-monospace"
                                               value="@mapping.Value"
                                               placeholder="@LDesigner["PlaceholderSubParam"]"
                                               readonly
                                               tabindex="-1" />
                                    </div>
                                }
                                @if (!subData.OutputMappings.Any())
                                {
                                    <p class="small text-muted">@LDesigner["SubProcessNoOutputParamsHint"]</p>
                                }
                            </div>
                        }
                    }

                    @if (node is WorkflowNodeModel { Data: WaitNodeData waitData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["DurationLabel"]</label>
                            <div class="input-group">
                                <input type="number" class="form-control" min="1"
                                       value="@waitData.Duration"
                                       @oninput="e => { waitData.Duration = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }" />
                                <select class="form-select" style="max-width:140px;"
                                        value="@waitData.Unit"
                                        @onchange="e => { waitData.Unit = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }">
                                    <option value="Seconds">@LDesigner["UnitSeconds"]</option>
                                    <option value="Minutes">@LDesigner["UnitMinutes"]</option>
                                    <option value="Hours">@LDesigner["UnitHours"]</option>
                                    <option value="Days">@LDesigner["UnitDays"]</option>
                                </select>
                            </div>
                            <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["WaitDurationVariablesHint"].Value, "<code>{{$node.123.output}}</code>"))</small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: WebhookWaitNodeData webhookData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["WaitTimeoutLabel"]</label>
                            <input type="number" class="form-control" min="0"
                                   value="@webhookData.TimeoutSeconds"
                                   @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var seconds)) { webhookData.TimeoutSeconds = seconds; } else { webhookData.TimeoutSeconds = 0; } OnWorkflowChanged(); }"
                                   placeholder="@LDesigner["WaitDurationPlaceholder"]" />
                            <small class="form-text text-muted">@LDesigner["WaitTimeoutHint"]</small>
                        </div>
                        <div class="card bg-light border-0 mt-3" style="border-radius: 8px;">
                            <div class="card-body p-3">
                                <h6 class="card-title d-flex align-items-center gap-2 mb-2" style="font-size: 0.85rem; font-weight: 700; color: #1e293b;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                    Callback URL
                                </h6>
                                <p class="card-text mb-2" style="font-size: 0.75rem; color: #64748b; line-height: 1.4;">
                                    @LDesigner["CallbackUrlDescription"]
                                </p>
                                <div class="bg-white p-2 rounded border font-monospace mb-2" style="font-size: 0.7rem; color: #334155; word-break: break-all; border-color: #e2e8f0 !important;">
                                    https://[base-url]/workflow/api/webhook/{botId}/{clientId}?channel={channel}
                                </div>
                                <ul style="font-size: 0.7rem; color: #475569; padding-left: 1.2rem; margin-bottom: 0;">
                                    <li class="mb-1"><strong>[base-url]</strong> — @LDesigner["CallbackUrlBaseUrl"]</li>
                                    <li class="mb-1"><strong>botId</strong> — @LDesigner["CallbackUrlBotId"]</li>
                                    <li class="mb-1"><strong>clientId</strong> — @LDesigner["CallbackUrlClientId"]</li>
                                    <li><strong>channel</strong> — @((MarkupString)LDesigner["CallbackUrlChannel"].Value)</li>
                                </ul>
                            </div>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: TimerStartNodeData timerData })
                    {
                        <div class="mb-3">
                            <label class="form-label">@LDesigner["ScheduleTypeLabel"]</label>
                            <select class="form-select"
                                    value="@timerData.ScheduleType"
                                    @onchange="e => { timerData.ScheduleType = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }">
                                <option value="OneTime">@LDesigner["ScheduleTypeOneTime"]</option>
                                <option value="Cron">@LDesigner["ScheduleTypeCron"]</option>
                            </select>
                        </div>

                        @if (timerData.ScheduleType == "OneTime")
                        {
                            <div class="mb-3">
                                <label class="form-label">@LDesigner["DateTimeLabel"]</label>
                                <input type="datetime-local" class="form-control"
                                       value="@timerData.FireTimeUtc"
                                       @oninput="e => { timerData.FireTimeUtc = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">@LDesigner["CronExpressionLabel"]</label>
                                <input type="text" class="form-control font-monospace"
                                       value="@timerData.CronExpression"
                                       placeholder="0 0 10 * * ?"
                                       @oninput="e => { timerData.CronExpression = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }" />
                                <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["CronExampleHint"].Value, "<code>0 0 10 * * ?</code>"))</small>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">@LDesigner["TimezoneLabel"]</label>
                            <input type="text" class="form-control" list="tz-list"
                                   value="@timerData.Timezone"
                                   placeholder="@UserTimezone"
                                   @oninput="e => { timerData.Timezone = e.Value?.ToString() ?? string.Empty; OnWorkflowChanged(); }" />
                            <datalist id="tz-list">
                                @foreach (var tz in CommonTimezones)
                                {
                                    var offset = TimezoneOffsets.GetValueOrDefault(tz.Id, "");
                                    <option value="@tz.Id">@tz.Label (@offset)</option>
                                }
                            </datalist>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@LDesigner["ClientFilterLabel"]</label>
                            <small class="form-text text-muted d-block mb-2">
                                @LDesigner["ClientFilterHint"]
                            </small>

                            @if (AvailableChannels.Count > 0)
                            {
                                <div class="card p-3 mb-2 border-secondary shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-bold">@LDesigner["ChannelsLabel"]</span>
                                    </div>
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var ch in AvailableChannels)
                                        {
                                            var isSelected = timerData.ClientFilter?.Channels?.Contains(ch.Id) == true;
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="@($"ch-{ch.Id}")" checked="@isSelected"
                                                       @onchange="e => {
                                                           timerData.ClientFilter ??= new ClientFilterCriteria();
                                                           var isChecked = e.Value is bool b && b;
                                                           if (isChecked)
                                                               timerData.ClientFilter.Channels.Add(ch.Id);
                                                           else
                                                               timerData.ClientFilter.Channels.RemoveAll(x => x == ch.Id);
                                                           OnWorkflowChanged();
                                                       }" />
                                                <label class="form-check-label d-flex align-items-center gap-1" for="@($"ch-{ch.Id}")">
                                                    @ch.Name
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:0.7rem;">@ch.ChannelType</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="mb-2">
                                <label class="form-label">@LDesigner["AttributeConditionsLabel"]</label>
                                @if (timerData.ClientFilter != null && timerData.ClientFilter.AttributeConditions.Count > 0)
                                {
                                    <div class="mb-2">
                                        <span class="small text-muted">@GetFilterLogicLabel(timerData.ClientFilter.Logic)</span>
                                        <div class="mt-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetFilterLogicAnd(timerData)">@LDesigner["AndLabel"]</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => SetFilterLogicOr(timerData)">@LDesigner["OrLabel"]</button>
                                        </div>
                                    </div>
                                }
                                @if (timerData.ClientFilter?.AttributeConditions != null)
                                {
                                    @for (var condIdx = 0; condIdx < timerData.ClientFilter.AttributeConditions.Count; condIdx++)
                                    {
                                        var cond = timerData.ClientFilter.AttributeConditions[condIdx];
                                        var idx = condIdx;
                                        var borderClass = cond.Operator switch
                                        {
                                            "equals" or "notequals" => "border-primary",
                                            "contains" or "startswith" or "endswith" => "border-success",
                                            "greaterThan" or "lessThan" or "greaterOrEqual" or "lessOrEqual" => "border-warning",
                                            "regex" or "inList" => "border-dark",
                                            _ => "border-secondary"
                                        };
                                        <div class="card p-3 mb-3 @borderClass shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="small fw-bold">@LDesigner["LabelCondition"] @(idx + 1)</span>
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFilterCondition(timerData, cond)">
                                                    <span class="oi oi-trash"></span>
                                                </button>
                                            </div>
                                            <div class="mb-2 designer-var-row">
                                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                                    <span>@LDesigner["LabelKey"]</span>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary designer-var-picker-btn" title="@LDesigner["InsertVariableTooltip"]" @onclick="() => ShowVariablePicker(v => InsertVariable(cond, nameof(cond.AttributeKey), v))"><span class="oi oi-code"></span> {}</button>
                                                </label>
                                                <input type="text" class="form-control variable-input" placeholder="name, email, ..."
                                                       value="@ToDisplayText(cond.AttributeKey)"
                                                       @oninput="e => { UpdateFieldAndCheckAtMention(e, cond, nameof(cond.AttributeKey)); OnWorkflowChanged(); }"/>
                                            </div>
                                            <div class="text-center my-1"><span class="badge @GetFilterOperatorBadgeClass(cond.Operator)">@GetFilterOperatorBadgeText(cond.Operator)</span></div>
                                            <div class="mb-2 position-relative">
                                                <div class="designer-condition-type-dropdown @(_filterOperatorDropdownOpenIdx == idx ? "open" : "")">
                                                    <button type="button"
                                                            class="designer-condition-type-trigger"
                                                            @onclick="() => _filterOperatorDropdownOpenIdx = _filterOperatorDropdownOpenIdx == idx ? -1 : idx"
                                                            aria-haspopup="listbox"
                                                            aria-expanded="@(_filterOperatorDropdownOpenIdx == idx)">
                                                        <span class="designer-condition-type-trigger-text">@GetFilterOperatorLabel(cond.Operator)</span>
                                                        <span class="oi oi-chevron-bottom designer-condition-type-chevron"></span>
                                                    </button>
                                                    @if (_filterOperatorDropdownOpenIdx == idx)
                                                    {
                                                        <div class="designer-condition-type-backdrop" @onclick="() => _filterOperatorDropdownOpenIdx = -1"></div>
                                                        <ul class="designer-condition-type-menu" role="listbox">
                                                            @foreach (var opt in FilterOperatorOptions)
                                                            {
                                                                var optValue = opt.Value;
                                                                var optLabel = opt.Label;
                                                                var isSelected = cond.Operator == optValue;
                                                                <li role="option" aria-selected="@isSelected">
                                                                    <button type="button"
                                                                            class="designer-condition-type-item @(isSelected ? "selected" : "")"
                                                                            @onclick="() => { cond.Operator = optValue; _filterOperatorDropdownOpenIdx = -1; OnWorkflowChanged(); }">
                                                                        @optLabel
                                                                    </button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                            @if (cond.Operator != "isEmpty" && cond.Operator != "isNotEmpty")
                                            {
                                                <div class="designer-var-row mb-2">
                                                    <label class="small text-muted d-flex justify-content-between align-items-center">
                                                        <span>@(cond.Operator == "inList" ? LDesigner["LabelValuesCommaSeparated"] : cond.Operator == "regex" ? LDesigner["LabelRegexPattern"] : LDesigner["LabelValue"])</span>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary designer-var-picker-btn" title="@LDesigner["InsertVariableTooltip"]" @onclick="() => ShowVariablePicker(v => InsertVariable(cond, nameof(cond.Value), v))"><span class="oi oi-code"></span> {}</button>
                                                    </label>
                                                    <input type="text" class="form-control @(cond.Operator == "regex" ? "font-monospace" : "") variable-input"
                                                           placeholder="@(cond.Operator == "inList" ? "a, b, c" : cond.Operator == "regex" ? "\\d+" : LDesigner["LabelValue"].Value)"
                                                           value="@ToDisplayText(cond.Value)"
                                                           @oninput="e => { UpdateFieldAndCheckAtMention(e, cond, nameof(cond.Value)); OnWorkflowChanged(); }"/>
                                                    <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["EnterAtToSelectVar"].Value, "<kbd>@@</kbd>"))</small>
                                                </div>
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" id="fic-@idx"
                                                           checked="@(cond.IgnoreCase ?? false)"
                                                           @onchange="e => ToggleFilterIgnoreCase(cond, e)"/>
                                                    <label class="form-check-label small text-muted" for="fic-@idx">@LDesigner["IgnoreCase"]</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                <button type="button" class="designer-ask-add" @onclick="() => AddFilterCondition(timerData)">
                                    <span class="oi oi-plus"></span> @LDesigner["AddCondition"]
                                </button>
                            </div>
                        </div>
                    }
                }
                else if (SelectedModel is WorkflowLinkModel link)
                {
                    <div class="section-title mb-3 fw-bold">@LDesigner["TransitionLogic"]</div>

                    <div class="mb-3">
                        <label class="form-label">@LDesigner["ConditionType"]</label>
                        <div class="designer-condition-type-dropdown @(_conditionTypeDropdownOpen ? "open" : "")">
                            <button type="button"
                                    id="condition-type-trigger"
                                    class="designer-condition-type-trigger"
                                    @onclick="() => _conditionTypeDropdownOpen = !_conditionTypeDropdownOpen"
                                    aria-haspopup="listbox"
                                    aria-expanded="@_conditionTypeDropdownOpen">
                                <span class="designer-condition-type-trigger-text">@GetConditionTypeDisplayLabel(link)</span>
                                <span class="oi oi-chevron-bottom designer-condition-type-chevron"></span>
                            </button>
                            @if (_conditionTypeDropdownOpen)
                            {
                                <div class="designer-condition-type-backdrop" @onclick="() => _conditionTypeDropdownOpen = false"></div>
                                <ul id="condition-type-menu" class="designer-condition-type-menu designer-condition-type-menu--fixed" role="listbox">
                                    @foreach (var opt in ConditionTypeOptions)
                                    {
                                        var value = opt.Value;
                                        var label = opt.Label;
                                        var isSelected = (value == "none" && link.Condition == null) ||
                                                         (value == "and" && link.Condition?.And != null) ||
                                                         (value == "or" && link.Condition?.Or != null) ||
                                                         (value == "equals" && link.Condition?.Equals != null) ||
                                                         (value == "notEquals" && link.Condition?.NotEquals != null) ||
                                                         (value == "contains" && link.Condition?.Contains != null) ||
                                                         (value == "startsWith" && link.Condition?.StartsWith != null) ||
                                                         (value == "endsWith" && link.Condition?.EndsWith != null) ||
                                                         (value == "greaterThan" && link.Condition?.GreaterThan != null) ||
                                                         (value == "lessThan" && link.Condition?.LessThan != null) ||
                                                         (value == "greaterOrEqual" && link.Condition?.GreaterOrEqual != null) ||
                                                         (value == "lessOrEqual" && link.Condition?.LessOrEqual != null) ||
                                                         (value == "inList" && link.Condition?.InList != null) ||
                                                         (value == "regex" && link.Condition?.Regex != null) ||
                                                         (value == "isEmpty" && link.Condition?.IsEmpty != null) ||
                                                         (value == "isNotEmpty" && link.Condition?.IsNotEmpty != null);
                                        <li role="option" aria-selected="@isSelected">
                                            <button type="button"
                                                    class="designer-condition-type-item @(isSelected ? "selected" : "")"
                                                    @onclick="() => { OnConditionTypeChanged(link, value); }">
                                                @label
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    @if (link.Condition?.IsComposite == true)
                    {
                        <div class="mb-3">
