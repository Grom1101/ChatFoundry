                }

                <hr/>
                <div class="mt-3">
                    <button class="btn btn-outline-danger w-100" @onclick="DeleteSelectedModel">
                        <span class="oi oi-trash"></span> @LDesigner["DeleteBtn"]
                    </button>
                </div>
            </div>
        </div>
        }

    </main>
</div>

