                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" id="rx-ignoreCase" checked="@(link.Condition.Regex.IgnoreCase == true)" @onchange="@(e => link.Condition!.Regex!.IgnoreCase = (bool)e.Value!)"/>
