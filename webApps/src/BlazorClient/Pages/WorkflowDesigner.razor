                            <input type="text" class="form-control font-monospace variable-input" value="@ToDisplayText(link.Condition.IsEmpty.Left)" @oninput="e => { UpdateFieldAndCheckAtMention(e, link.Condition!.IsEmpty!, nameof(UnaryConditionBase.Left)); OnWorkflowChanged(); }" placeholder="$variable_name"/>
                            <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["EnterAtToSelectVar"].Value, "<kbd>@@</kbd>"))</small>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-secondary">@LDesigner["BadgeIsEmpty"]</span></div>
                        </div>
                    }
                    else if (link.Condition?.IsNotEmpty != null)
                    {
                        <div class="card p-3 border-secondary mb-3 shadow-sm">
                            <div class="designer-var-row mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>@LDesigner["VariableLabel"]</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary designer-var-picker-btn" title="@LDesigner["InsertVariableTooltip"]" @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition!.IsNotEmpty!, nameof(UnaryConditionBase.Left), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                            </label>
                            <input type="text" class="form-control font-monospace variable-input" value="@ToDisplayText(link.Condition.IsNotEmpty.Left)" @oninput="e => { UpdateFieldAndCheckAtMention(e, link.Condition!.IsNotEmpty!, nameof(UnaryConditionBase.Left)); OnWorkflowChanged(); }" placeholder="$variable_name"/>
                            <small class="form-text text-muted">@((MarkupString)string.Format(LDesigner["EnterAtToSelectVar"].Value, "<kbd>@@</kbd>"))</small>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-secondary">@LDesigner["BadgeIsNotEmpty"]</span></div>
                        </div>
                    }

                    @if (link.Condition != null && !link.Condition.IsComposite)
                    {
                        <div class="mb-3">
                            <span class="small text-muted">@LDesigner["JoinConditionsLabel"]:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => ConvertToAnd(link)">@LDesigner["AndLabel"]</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => ConvertToOr(link)">@LDesigner["OrLabel"]</button>
