@page "/profile"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IStringLocalizer<Profile> LProfile

<PageTitle>@LProfile["PageTitle"] — ChatFoundry</PageTitle>

<div class="profile-page content">
    @if (loadError != null)
    {
        <div class="profile-error">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>@loadError</span>
        </div>
    }
    else if (me != null)
    {
        var nameFromEmail = string.IsNullOrEmpty(me.Email) ? "—" : (me.Email.Contains('@') ? me.Email[..me.Email.IndexOf('@')] : me.Email);
        var createdAtFormatted = me.CreatedAt == default ? "—" : me.CreatedAt.ToString("dd.MM.yyyy");
        var initial = string.IsNullOrEmpty(nameFromEmail) || nameFromEmail == "—" ? "?" : char.ToUpperInvariant(nameFromEmail[0]).ToString();

        <div class="profile-hero">
            <div class="profile-avatar" aria-hidden="true">@initial</div>
            <h1 class="profile-title">@nameFromEmail</h1>
            <p class="profile-subtitle">@LProfile["AccountSubtitle"]</p>
        </div>

        <section class="profile-section">
            <h2 class="profile-section-title">@LProfile["SectionTitle"]</h2>
            <div class="profile-cards">
                <div class="profile-card">
                    <div class="profile-card-icon profile-card-icon-email">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="M22 7l-10 6L2 7"/>
                        </svg>
                    </div>
                    <div class="profile-card-body">
                        <span class="profile-card-label">@LProfile["LabelEmail"]</span>
                        <span class="profile-card-value">@(me.Email ?? "—")</span>
                    </div>
                </div>
                <div class="profile-card">
                    <div class="profile-card-icon profile-card-icon-name">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="profile-card-body">
                        <span class="profile-card-label">@LProfile["LabelName"]</span>
                        <span class="profile-card-value">@nameFromEmail</span>
                    </div>
                </div>
                <div class="profile-card">
                    <div class="profile-card-icon profile-card-icon-date">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div class="profile-card-body">
                        <span class="profile-card-label">@LProfile["LabelRegDate"]</span>
                        <span class="profile-card-value">@createdAtFormatted</span>
                    </div>
                </div>
            </div>

            <div class="profile-actions">
                <a href="@GetChangePasswordHref()" class="profile-btn profile-btn-secondary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                    <span>@LProfile["BtnChangePassword"]</span>
                </a>
            </div>
        </section>
    }

    @if (isLoading)
    {
        <div class="profile-loading">
            <div class="profile-spinner" aria-hidden="true"></div>
            <span class="profile-loading-text">@LProfile["LoadingProfile"]</span>
        </div>
    }
</div>

@code {
    [Inject] private IIdentityApiClient IdentityApi { get; set; } = null!;

    private MeDto? me;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            me = await IdentityApi.GetMeAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetChangePasswordHref()
    {
        var email = me?.Email ?? "";
        return string.IsNullOrEmpty(email)
            ? "/forgot-password"
            : $"/forgot-password?email={Uri.EscapeDataString(email)}";
    }
}
