# LlmProviders (OpenAiCompatible)
LlmProviders__OpenAiCompatible__0__ApiKey=<your-openai-api-key>
LlmProviders__OpenAiCompatible__0__ApiUrl=https://api.openai.com/v1/chat/completions
LlmProviders__OpenAiCompatible__0__Model=gpt-3.5-turbo

# GLM (zhipu AI) settings
LlmProviders__OpenAiCompatible__1__ApiKey=<your-glm-api-key>
LlmProviders__OpenAiCompatible__1__ApiUrl=https://api.z.ai/api/coding/paas/v4/chat/completions
LlmProviders__OpenAiCompatible__1__Model=GLM-4.6

# FreeLlm settings
LlmProviders__OpenAiCompatible__2__ApiKey=freellmapi-placeholder-token
LlmProviders__OpenAiCompatible__2__ApiUrl=http://freellmapi-service:3001/v1/chat/completions
LlmProviders__OpenAiCompatible__2__Model=auto

# Gateway URL (used as the public base URL for Ngrok local tunneling or production deployment)
Gateway__Url=https://your-ngrok-subdomain.ngrok-free.app

# Telegram Service
Telegram__SecretToken=<generate-random-guid>
Sms__ApiKey=<your-infinireach-api-key>

# OpenIddict: общий ключ шифрования access token (Base64, 32 bytes). Один и тот же ключ для IdentityServer и Gateway.
# Сгенерировать в PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
OpenIddict__EncryptionKey=<your-openIddict-key>

# OpenIddict: постоянный сертификат подписи access token (Base64 PFX). Используется всеми репликами IdentityServer.
# Сгенерировать в PowerShell:
# $cert = New-SelfSignedCertificate -Subject "CN=ChatFoundry Identity Signing Certificate" -CertStoreLocation "Cert:\CurrentUser\My" -KeyExportPolicy Exportable -KeySpec Signature -KeyLength 2048 -KeyAlgorithm RSA -HashAlgorithm SHA256 -NotAfter (Get-Date).AddYears(5)
# $pwd = ConvertTo-SecureString -String "your-cert-password" -Force -AsPlainText
# Export-PfxCertificate -Cert $cert -FilePath "$env:TEMP\signing.pfx" -Password $pwd
# [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("$env:TEMP\signing.pfx"))
OpenIddict__SigningCertificate=<your-signing-certificate-base64>
OpenIddict__SigningCertificatePassword=<your-signing-certificate-password>

# IdentityServer: SMTP (Gmail app password)
Smtp__Password=<your-smtp-app-password>

# Ngrok
NGROK_AUTHTOKEN=<your-ngrok-authtoken>

# FreeLLMAPI settings
FREELLM_ENCRYPTION_KEY=<your-freellm-key>

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

