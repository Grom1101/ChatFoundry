<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Google.Protobuf" Version="3.33.2" />
      <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
      <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
      <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
      <PackageReference Include="Grpc.Net.ClientFactory" Version="2.76.0" />
      <PackageReference Include="Grpc.Tools" Version="2.76.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="WorkflowProtos\bot_token.proto" GrpcServices="Both" />
        <Protobuf Include="ClientProtos\client.proto" GrpcServices="Both" />
        <Protobuf Include="FileProtos\file.proto" GrpcServices="Both" />
        <Protobuf Include="CompanyProtos\company_registration.proto" GrpcServices="Both" />
        <Protobuf Include="IdentityProtos\user_company.proto" GrpcServices="Both" />
        <Protobuf Include="BillingProtos\billing.proto" GrpcServices="Both" />
        <Protobuf Include="SchedulerProtos\scheduler.proto" GrpcServices="Both" />
    </ItemGroup>

</Project>
